---
import { getCollection } from 'astro:content';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { BASE, SITE } from '../config';
import '../styles/global.css';
// Тот же файл, что берёт CSS fontsource: Vite отдаёт один хешированный адрес, предзагрузка не качает шрифт дважды
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import monoCyrillic from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-cyrillic-wght-normal.woff2?url';
import literataCyrillic from '@fontsource-variable/literata/files/literata-cyrillic-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string; // путь картинки превью от корня сайта; без неё берётся общая картинка блога
  viewArticle?: string;
}

const { title, description, ogImage, viewArticle } = Astro.props;

const pages = await getCollection('pages', (entry) => !entry.data.draft);
const hasAbout = pages.some((entry) => entry.id === 'about-me');
const hasNotes = (await getCollection('notes')).some((note) => !note.data.draft);
const fullTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const desc = description ?? SITE.description;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
// Страница 404 отдаётся по любому неверному адресу, своего адреса у неё нет: канонический /404/
// вёл в никуда и выдавал её поисковику за обычную страницу
const isNotFound = /\/404\/?$/.test(Astro.url.pathname);
const ogImageUrl = new URL(ogImage ?? `${BASE}og/default.png`, SITE.url).href;
const ogType = Astro.url.pathname.startsWith(`${BASE}blog/`) ? 'article' : 'website';
---

<!doctype html>
<html lang="ru" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={monoCyrillic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={literataCyrillic} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {!isNotFound && <link rel="canonical" href={canonical} />}
    <!-- Блог расходится ссылками из чатов: без og-меты мессенджер показывает голый адрес -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    {!isNotFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <link rel="alternate" type="application/rss+xml" title="Статьи" href={`${BASE}rss.xml`} />
    {hasNotes && <link rel="alternate" type="application/rss+xml" title="Заметки" href={`${BASE}notes.xml`} />}

    <script is:inline>
      (function() {
        document.documentElement.classList.add('js'); // без JS скрываем настройки чтения
        // Тёмная тема прибита в разметке; из хранилища читаем только то, что меняет вид текста

        // Тот же ключ, что у кнопок в theme.js: иначе страница рисуется в md и перескакивает, когда модуль применит сохранённый размер
        const font = localStorage.getItem('font-size-v2');
        document.documentElement.dataset.font = ['xs', 'sm', 'md', 'lg', 'xl'].includes(font) ? font : 'md';

        // Банка для акцента из настроек чтения: красит ссылки до первой отрисовки; тот же ключ, что в theme.js
        const flavor = localStorage.getItem('flavor');
        document.documentElement.dataset.flavor = ['original', 'ultra-white', 'khaos', 'mango', 'vr46', 'ultra-black'].includes(flavor) ? flavor : 'original';
      })();
    </script>
  </head>
  <body data-count-view={isNotFound ? undefined : ''} data-view-article={viewArticle}>
    <a href="#main" class="skip-link">к содержанию</a>
    <div class="app-layout">
      <NavBar hasAbout={hasAbout} hasNotes={hasNotes} />
      <main id="main">
        <slot />
      </main>
      <Footer showViews={!isNotFound} />
    </div>

    <script>
      import '../scripts/theme.js';
      import '../scripts/ref-tip.js';
      import '../scripts/views';
    </script>
  </body>
</html>
