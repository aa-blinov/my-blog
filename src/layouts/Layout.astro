---
import { getCollection } from 'astro:content';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { BASE, SITE } from '../config';
import { getBreadcrumb } from '../utils/breadcrumb';
import { sortByDateDesc } from '../utils/date';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const blogEntries = sortByDateDesc((await getCollection('blog')).filter((e) => !e.data.draft)).map((entry) => {
  return {
    id: `${entry.id}.md`, // File-like path for the sidebar tree, e.g. 'science/human-body/article.md'
    slug: entry.id, // URL path like 'science/human-body/article'
    title: entry.data.title,
    date: entry.data.date,
    section: entry.data.section, // Still support frontmatter override
  };
});

const pages = (await getCollection('pages')).filter((e) => !e.data.draft);
const mainEntry = pages.find((e) => e.id === 'main');
const aboutEntry = pages.find((e) => e.id === 'about-me');

const mainForSidebar = mainEntry ? { slug: mainEntry.id, title: mainEntry.data.title, date: mainEntry.data.date } : null;
const aboutForSidebar = aboutEntry ? { slug: aboutEntry.id, title: aboutEntry.data.title, date: aboutEntry.data.date } : null;
const fullTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const desc = description ?? SITE.description;
const breadcrumbPath = getBreadcrumb(Astro.url.pathname);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        
        const font = localStorage.getItem('font-size') || 'md';
        document.documentElement.dataset.font = font;
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">к содержанию</a>
    <div class="app-layout">
      <NavBar breadcrumbPath={breadcrumbPath} />
      <div class="main-container">
        <div class="main-grid">
          <aside id="layout-sidebar">
            <Sidebar blogEntries={blogEntries} mainEntry={mainForSidebar} aboutEntry={aboutForSidebar} />
          </aside>
          <main id="main" tabindex="-1">
            <slot />
          </main>
        </div>
        <Footer />
      </div>
    </div>

    <script defer src={`${BASE}theme.js`}></script>
  </body>
</html>
