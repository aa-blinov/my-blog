---
import type { PickerData } from '../utils/picker';
import type { MapSource } from '../utils/mindmap';

interface Props {
  data: PickerData;
}

const { data } = Astro.props;

// Источники нумеруются один раз на страницу; клиенту уходят номера, а не повторы текста
const sources: MapSource[] = [];
const num = new Map<string, number>();
const reg = (list?: MapSource[]) => (list ?? []).map((s) => {
  if (!num.has(s.url)) { sources.push(s); num.set(s.url, sources.length); }
  return num.get(s.url)!;
});
const client = {
  map: data.mapHref ?? '',
  drugs: data.drugs.map((d) => ({ id: d.id, label: d.label, tier: d.tier, ru: d.registeredRu, src: reg(d.tierSources) })),
  rules: Object.fromEntries(data.rules.map((r) => [r.when, r.effects.map((e) => ({ d: e.drugs, k: e.kind, r: e.reason, s: reg(e.sources) }))])),
  history: {
    helped: { k: data.history.helped.kind, r: data.history.helped.reason, s: reg(data.history.helped.sources) },
    failed: { k: data.history.failed.kind, r: data.history.failed.reason, s: reg(data.history.failed.sources) },
  },
  alerts: data.alerts.map((a) => ({ w: a.when, l: a.level, t: a.text, s: reg(a.sources) })),
  sources: sources.map((s) => [s.title, s.url]),
};
---

<div class="pk" data-picker>
  <div class="pk-disclaimer pk-disclaimer-box">
    <p class="pk-urgent-line" set:html={(data.urgentLine ?? '').replace('112', '<a href="tel:112">112</a>')}></p>
    <details class="pk-disclaimer-more" open>
      <summary><strong>Это не назначение.</strong> <span class="pk-more-link">Подробнее</span></summary>
      <p>{data.disclaimer}</p>
    </details>
  </div>
  <p class="pk-noscript">Подборщику нужен JavaScript. Без него отметки не работают. Карточки препаратов есть на <a href={data.mapHref}>карте</a>.</p>

  <div class="pk-layout">
    <form class="pk-form" aria-label="Особенности пациента">
      {data.groups.map((g) => (
        <details class="pk-group" open>
          <summary class="pk-group-title">{g.label}<span class="pk-count"></span></summary>
          {data.options.filter((o) => o.group === g.id).map((o) => (
            <label class="pk-opt">
              <input type="checkbox" name="o" value={o.id} />
              <span>{o.label}{o.hint && <span class="pk-hint">{o.hint}</span>}</span>
            </label>
          ))}
          {g.id === 'safety' && <div class="pk-urgent"></div>}
        </details>
      ))}
      <details class="pk-group" open>
        <summary class="pk-group-title">Опыт лечения<span class="pk-count"></span></summary>
        <label class="pk-select">
          <span>Раньше помог</span>
          <select name="helped">
            <option value="">не было</option>
            {data.drugs.map((d) => <option value={d.id}>{d.label}</option>)}
          </select>
        </label>
        <label class="pk-select">
          <span>Не подошёл</span>
          <select name="failed">
            <option value="">не было</option>
            {data.drugs.map((d) => <option value={d.id}>{d.label}</option>)}
          </select>
        </label>
      </details>
      <p class="pk-actions"><button type="reset" class="pk-reset">Сбросить отметки</button></p>
    </form>

    <section class="pk-result" id="pk-result" aria-label="Что обсудить с врачом">
      <div class="pk-alerts"></div>
      <h2 class="pk-h">Что обсудить с врачом</h2>
      <details class="pk-gloss">
        <summary>Словарь: первая линия, СИОЗС и другие сокращения</summary>
        <p><strong>Первая линия:</strong> препараты, с которых обычно начинают лечение.</p>
        <p><strong>СИОЗС:</strong> селективные ингибиторы обратного захвата серотонина, основная группа первой линии, например сертралин и эсциталопрам.</p>
        <p><strong>СИОЗСН:</strong> то же для серотонина и норадреналина, например венлафаксин и дулоксетин.</p>
        <p><strong>ИМАО:</strong> старая группа антидепрессантов с жёсткими ограничениями по лекарствам и питанию.</p>
        <p><strong>Бирс:</strong> список лекарств, которых пожилым людям лучше избегать.</p>
        <p><strong>QT:</strong> интервал на ЭКГ; часть препаратов его удлиняет.</p>
        <p><strong>CYP2D6:</strong> фермент печени, который перерабатывает часть лекарств.</p>
        <p><strong>НПВП:</strong> нестероидные противовоспалительные, например ибупрофен и диклофенак.</p>
        <p><strong>CANMAT:</strong> канадские рекомендации по лечению депрессии, один из основных источников.</p>
        <p><strong>ОКР:</strong> обсессивно-компульсивное расстройство.</p>
      </details>
      <p class="pk-summary" role="status"></p>
      <div class="pk-lists"></div>
      <p class="pk-to-review"><a href="#pk-review">Открытые вопросы для врача</a>, внизу подборщика.</p>
    </section>
    <nav class="pk-steps" aria-label="Шаги анкеты">
      <p class="pk-steps-where" aria-live="polite"></p>
      <div class="pk-steps-btns">
        <button type="button" class="pk-steps-prev">Назад</button>
        <button type="button" class="pk-steps-next">Дальше</button>
      </div>
    </nav>
  </div>
  {data.review && (
    <details class="pk-review" id="pk-review">
      <summary>Для врача: открытые вопросы по правилам ({data.review.items.filter((i) => i.question).length})</summary>
      <p class="pk-note">{data.review.lead}</p>
      <ol class="pk-review-list">
        {data.review.items.map((i) => (
          <li>
            <p><strong>{i.title}.</strong> {i.text}</p>
            {i.question && <p class="pk-review-q">Вопрос: {i.question}</p>}
            {i.sources.length > 0 && (
              <p class="pk-review-src">Источники: {i.sources.map((s, n) => (<>{n > 0 && ' · '}<a href={s.url}>{s.title}</a></>))}</p>
            )}
          </li>
        ))}
      </ol>
    </details>
  )}
  <a class="pk-jump" href="#pk-result">к результату ↓</a>
  <script type="application/json" class="pk-data" set:html={JSON.stringify(client).replace(/</g, '\\u003c')} />
</div>

<script>
  // Подсчёт на клиенте: линия по рекомендациям даёт основу, отмеченные особенности сдвигают препарат вверх или вниз,
  // «не подходит» исключает. Порядок внутри групп: сумма, потом линия
  type Eff = { d?: string[]; k: 'prefer' | 'consider' | 'note' | 'caution' | 'avoid'; r: string; s: number[]; hist?: boolean };
  type Data = {
    map: string;
    drugs: { id: string; label: string; tier: number; ru: boolean; src: number[] }[];
    rules: Record<string, Eff[]>;
    history: { helped: Eff; failed: Eff };
    alerts: { w: string; l: string; t: string; s: number[] }[];
    sources: [string, string][];
  };
  const WEIGHT = { prefer: 2, consider: 1, note: 0, caution: -1, avoid: -100 };
  const TIER_SCORE: Record<number, number> = { 1: 3, 2: 2, 3: 1 };
  const TIER_NAME: Record<number, string> = { 1: 'первая линия', 2: 'вторая линия', 3: 'третья линия' };

  document.querySelectorAll<HTMLElement>('[data-picker]').forEach((root) => {
    root.classList.add('js');
    const data: Data = JSON.parse(root.querySelector('.pk-data')!.textContent!);
    const urgentBox = root.querySelector<HTMLElement>('.pk-urgent');
    const form = root.querySelector<HTMLFormElement>('.pk-form')!;
    const alertsBox = root.querySelector<HTMLElement>('.pk-alerts')!;
    const lists = root.querySelector<HTMLElement>('.pk-lists')!;
    const summary = root.querySelector<HTMLElement>('.pk-summary')!;
    const groups = [...form.querySelectorAll<HTMLDetailsElement>('.pk-group')];
    const pref: Record<string, boolean> = {};
    const safetyGroup = urgentBox?.closest<HTMLDetailsElement>('.pk-group') ?? null;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const chips = (ns: number[]) => ns.length ? ' <span class="ref-run">' + ns.map((n) => {
      const [t, u] = data.sources[n - 1];
      return `<a class="ref" href="${esc(u)}" data-tip="${esc(t)}" aria-label="Источник ${n}: ${esc(t)}">[${n}]</a>`;
    }).join(' ') + '</span>' : '';
    // Сколько отмечено в каждой группе: видно в заголовке, даже когда группа свёрнута
    const updateCounts = () => groups.forEach((g) => {
      const n = g.querySelectorAll('input:checked').length + [...g.querySelectorAll('select')].filter((s) => s.value).length;
      const c = g.querySelector('.pk-count');
      if (c) c.textContent = n ? String(n) : '';
    });

    const render = () => {
      const fd = new FormData(form);
      const picked = fd.getAll('o') as string[];
      const helped = String(fd.get('helped') ?? '');
      const failed = String(fd.get('failed') ?? '');
      const state = new Map(data.drugs.map((d) => [d.id, { d, score: TIER_SCORE[d.tier], plus: [] as Eff[], notes: [] as Eff[], minus: [] as Eff[], avoid: [] as Eff[] }]));
      const apply = (e: Eff, ids: string[], hist = false) => ids.forEach((id) => {
        const st = state.get(id);
        if (!st) return;
        st.score += WEIGHT[e.k];
        const mark = hist ? { ...e, hist: true } : e;
        (e.k === 'avoid' ? st.avoid : e.k === 'caution' ? st.minus : e.k === 'note' ? st.notes : st.plus).push(mark);
      });
      picked.forEach((o) => (data.rules[o] ?? []).forEach((e) => apply(e, e.d ?? [])));
      // Помог и не помог у одного препарата: противоречие, учитываем неудачу как осторожность
      if (helped && helped !== failed) apply(data.history.helped, [helped], true);
      if (failed) apply(data.history.failed, [failed], true);
      const histCount = (helped && helped !== failed ? 1 : 0) + (failed ? 1 : 0);

      // Предупреждения сверху: срочное раньше результата
      const order = { urgent: 0, specialist: 1, info: 2 } as Record<string, number>;
      const alerts = data.alerts.filter((a) => picked.includes(a.w)).sort((a, b) => order[a.l] - order[b.l]);
      const alertHtml = (a: (typeof alerts)[number]) => `<p class="pk-alert pk-alert-${a.l}">${esc(a.t).replace('112', '<a href="tel:112">112</a>')}${chips(a.s)}</p>`;
      alertsBox.innerHTML = alerts.map(alertHtml).join('');
      // Срочное дублируем под группой «Безопасность»: на телефоне оно должно быть рядом с отметкой, а не в конце результата.
      // Группа при этом открывается, иначе срочное оказалось бы в свёрнутом блоке
      if (urgentBox) urgentBox.innerHTML = alerts.filter((a) => a.l === 'urgent').map(alertHtml).join('');
      if (safetyGroup && alerts.some((a) => a.l === 'urgent')) safetyGroup.open = true;
      updateCounts();

      // При равном счёте выше то, что зарегистрировано в России: читателю его реально могут назначить
      const all = [...state.values()].sort((a, b) => b.score - a.score || Number(b.d.ru) - Number(a.d.ru) || a.d.tier - b.d.tier);
      const avoid = all.filter((x) => x.avoid.length);
      const caution = all.filter((x) => !x.avoid.length && x.minus.length);
      const clean = all.filter((x) => !x.avoid.length && !x.minus.length);
      // «Первыми» только зарегистрированное в России и при этом первая линия или прямо рекомендованное при отмеченном:
      // отсутствие правил не значит, что препарат проверен и подходит. Подходящих меньше пяти, значит меньше пяти
      const eligible = (x: (typeof all)[number]) => x.d.ru && (x.d.tier === 1 || x.plus.some((e) => e.k === 'prefer' && !e.hist));
      const first = clean.filter(eligible).slice(0, 5);
      const more = clean.filter((x) => !first.includes(x));

      const reasonsOf = (x: (typeof all)[number]) => [...x.avoid, ...x.minus, ...x.notes, ...x.plus];
      // Ключ по виду и тексту причины: одна и та же фраза из разных правил считается одной, источники собираются вместе
      const keyOf = (e: Eff) => `${e.k}|${e.r}`;
      const reasonItem = (e: Eff) => `<li class="pk-r pk-r-${e.k}">${esc(e.r)}${chips(e.s)}</li>`;
      // Одна и та же причина у нескольких препаратов одного списка выводится один раз сверху, с перечнем препаратов
      const list = (items: typeof all) => {
        const by = new Map<string, { e: Eff; s: number[]; names: string[] }>();
        items.forEach((x) => {
          const seen = new Set<string>();
          reasonsOf(x).forEach((e) => {
            const k = keyOf(e);
            if (seen.has(k)) return;
            seen.add(k);
            const g = by.get(k) ?? { e, s: [] as number[], names: [] as string[] };
            g.names.push(x.d.label);
            g.s = [...new Set([...g.s, ...e.s])];
            by.set(k, g);
          });
        });
        const shared = new Set([...by].filter(([, g]) => g.names.length > 1).map(([k]) => k));
        const common = [...by].filter(([k]) => shared.has(k))
          .map(([, g]) => `<li class="pk-r pk-r-${g.e.k}">${esc(g.e.r)}${chips(g.s)}<span class="pk-common-who">Касается: ${g.names.map(esc).join(', ')}</span></li>`)
          .join('');
        const rows = items.map((x) => {
          const rest = reasonsOf(x).filter((e) => !shared.has(keyOf(e))).map(reasonItem).join('');
          return `
        <li class="pk-drug">
          <p class="pk-name"><a href="${esc(data.map)}#map-${x.d.id}">${esc(x.d.label)}</a>
            <span class="pk-tier">${TIER_NAME[x.d.tier]}${chips(x.d.src)}${x.d.ru ? '' : ' ~ в России не зарегистрирован'}</span></p>
          ${rest ? `<ul class="pk-reasons">${rest}</ul>` : ''}
        </li>`;
        }).join('');
        return { common: common ? `<ul class="pk-reasons pk-common">${common}</ul>` : '', rows: `<ul class="pk-list">${rows}</ul>` };
      };
      const block = (title: string, cls: string, items: typeof all, note = '') => {
        if (!items.length) return '';
        const l = list(items);
        return `<h3 class="pk-sub ${cls}">${title}</h3>${note ? `<p class="pk-note">${note}</p>` : ''}${l.common}${l.rows}`;
      };
      const moreList = more.length ? list(more) : null;
      // Блоки результата открыты сразу: на телефоне результат идёт отдельным шагом, и свёрнутый блок там прячет нужное.
      // Что закрыл читатель вручную, сохраняем при пересчёте
      const fold = (key: string, title: string, cls: string, items: typeof all) => {
        if (!items.length) return '';
        const l = list(items);
        const open = pref[key] ?? true;
        return `<details class="pk-block" data-key="${key}"${open ? ' open' : ''}><summary><h3 class="pk-sub ${cls}">${title} (${items.length})</h3></summary>${l.common}${l.rows}</details>`;
      };

      const legend = first.length || caution.length || avoid.length
        ? '<p class="pk-legend">В причинах: <b>+</b> довод за препарат, <b>!</b> довод против, <b>~</b> обратить внимание, <b>×</b> не подходит.</p>'
        : '';
      lists.innerHTML = legend +
        block('Обычно обсуждают первыми', 'pk-sub-first', first, picked.length || helped || failed ? '' : 'Пока ничего не отмечено: это препараты первой линии по рекомендациям. Отметьте особенности в анкете, и список подстроится.') +
        (first.length ? '' : `<p class="pk-note">При отмеченном нет варианта без оговорок.${caution.length ? ` Ближе всего к рекомендации, с оговорками: ${caution.slice(0, 2).map((x) => esc(x.d.label)).join(' и ')}.` : ''} Это повод обсудить выбор с врачом подробнее, а не выбирать из списка ниже самому.</p>`) +
        fold('caution', 'Можно, но с осторожностью', 'pk-sub-caution', caution) +
        (moreList ? `<details class="pk-more"><summary>Другие варианты (${more.length})</summary><p class="pk-note">По отмеченному правил нет. Это не значит, что препарат подходит.</p>${moreList.common}${moreList.rows}</details>` : '') +
        fold('avoid', 'Не подходит при отмеченном', 'pk-sub-avoid', avoid);
      summary.textContent = picked.length || helped || failed
        ? `Учтено отметок: ${picked.length + histCount}. Первыми ${first.length}, с осторожностью ${caution.length}, не подходит ${avoid.length}.`
        : '';

      // Кнопка «к результату» показывает, сколько отмечено: видно и без прокрутки к анкете
      const marked = picked.length + histCount;
      if (jump) jump.textContent = marked ? `к результату ↓ · отмечено ${marked}` : 'к результату ↓';

      // Отметки в адресе: подборку можно переслать или открыть на приёме
      const q = new URLSearchParams();
      if (picked.length) q.set('o', picked.join(','));
      if (helped) q.set('helped', helped);
      if (failed) q.set('failed', failed);
      history.replaceState(null, '', location.pathname + (q.toString() ? '?' + q : '') + location.hash);
    };

    // Восстановить отметки из адреса
    const q = new URLSearchParams(location.search);
    (q.get('o') ?? '').split(',').filter(Boolean).forEach((v) => {
      const cb = form.querySelector<HTMLInputElement>(`input[value="${CSS.escape(v)}"]`);
      if (cb) cb.checked = true;
    });
    for (const k of ['helped', 'failed']) {
      const sel = form.querySelector<HTMLSelectElement>(`select[name="${k}"]`)!;
      if (q.get(k)) sel.value = q.get(k)!;
    }
    // На телефоне дисклеймер свёрнут, срочная строка видна. Анкета по шагам настраивается ниже
    if (matchMedia('(max-width: 991px)').matches) {
      const disc = root.querySelector<HTMLDetailsElement>('.pk-disclaimer-more');
      if (disc) disc.open = false;
    }
    // «к результату» не нужна, когда результат уже на экране
    // Ссылка нужна, пока анкета и результат за экраном: иначе она закрывает подписи в анкете
    const jump = root.querySelector<HTMLElement>('.pk-jump');
    const res = root.querySelector<HTMLElement>('.pk-result')!;
    if (jump) {
      const seen = new Set<Element>();
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
        jump.style.visibility = seen.size ? 'hidden' : '';
      });
      io.observe(res);
      io.observe(form);
      const review = root.querySelector('.pk-review');
      if (review) io.observe(review);
    }
    // Запоминаем, какой блок читатель открыл или свернул вручную
    lists.addEventListener('toggle', (e) => {
      const d = e.target as HTMLDetailsElement;
      if (d.dataset.key) pref[d.dataset.key] = d.open;
    }, true);
    // Ссылка на открытые вопросы для врача раскрывает их
    root.querySelectorAll<HTMLAnchorElement>('a[href="#pk-review"]').forEach((a) => a.addEventListener('click', () => {
      const r = root.querySelector<HTMLDetailsElement>('#pk-review');
      if (r) r.open = true;
    }));
    // Телефон: анкета по шагам. На экране одна группа, внизу «Назад» и «Дальше», последним шагом результат.
    // На широком экране и без JS всё стоит целиком, как раньше
    const stepMq = matchMedia('(max-width: 991px)');
    const last = groups.length; // шаг с результатом
    const nav = root.querySelector<HTMLElement>('.pk-steps')!;
    const where = nav.querySelector<HTMLElement>('.pk-steps-where')!;
    const prev = nav.querySelector<HTMLButtonElement>('.pk-steps-prev')!;
    const next = nav.querySelector<HTMLButtonElement>('.pk-steps-next')!;
    const actions = form.querySelector<HTMLElement>('.pk-actions');
    const reviewBox = root.querySelector<HTMLElement>('.pk-review');
    let cur = 0;
    const marked = () => form.querySelectorAll('input:checked').length + [...form.querySelectorAll('select')].filter((s) => s.value).length;
    const showStep = () => {
      const on = stepMq.matches;
      root.toggleAttribute('data-steps', on);
      if (!on) {
        groups.forEach((g) => g.classList.remove('is-off'));
        [res, actions, reviewBox].forEach((el) => el?.classList.remove('is-off'));
        return;
      }
      cur = Math.min(cur, last);
      groups.forEach((g, i) => { g.open = true; g.classList.toggle('is-off', i !== cur); });
      const isResult = cur === last;
      res.classList.toggle('is-off', !isResult);
      actions?.classList.toggle('is-off', !isResult);
      reviewBox?.classList.toggle('is-off', !isResult);
      where.textContent = isResult ? `Результат · отмечено ${marked()}` : `Шаг ${cur + 1} из ${last} · отмечено ${marked()}`;
      prev.classList.toggle('is-off', cur === 0);
      prev.textContent = isResult ? 'К анкете' : 'Назад';
      next.classList.toggle('is-off', isResult);
      next.textContent = cur === last - 1 ? 'К результату' : 'Дальше';
    };
    const go = (to: number) => { cur = to; showStep(); root.querySelector('.pk-layout')?.scrollIntoView({ block: 'start' }); };
    // Заголовок группы на телефоне не сворачивает её: группа и так на экране одна
    groups.forEach((g) => g.querySelector('summary')?.addEventListener('click', (e) => { if (stepMq.matches) e.preventDefault(); }));
    prev.addEventListener('click', () => go(cur - 1));
    next.addEventListener('click', () => go(cur + 1));
    stepMq.addEventListener('change', showStep);
    form.addEventListener('change', showStep);
    form.addEventListener('reset', () => setTimeout(showStep, 0));
    form.addEventListener('change', render);
    form.addEventListener('reset', () => setTimeout(render, 0));
    render();
    showStep();
  });
</script>
