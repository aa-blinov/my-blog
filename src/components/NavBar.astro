---
import Icon from './Icon.astro';
import { BASE } from '../config';

interface Props {
  hasAbout: boolean;
  hasNotes: boolean; // пустая лента в меню выглядит заброшенной: ссылка появится с первой опубликованной заметкой
}

const { hasAbout, hasNotes } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => currentPath === href.replace(/\/$/, '');
const links = [
  { label: 'архив', href: BASE + 'blog/' },
  ...(hasNotes ? [{ label: 'заметки', href: BASE + 'notes/' }] : []),
  ...(hasAbout ? [{ label: 'обо мне', href: BASE + 'about-me/' }] : []),
];
---

<header class="site-header">
  <nav class="site-nav" aria-label="Навигация по сайту">
    <a class="site-brand" href={BASE} aria-current={isCurrent(BASE) ? 'page' : undefined}><span class="nav-bracket">[</span>главная<span class="nav-bracket">]</span></a>
    <ul role="list">
      {links.map(({ label, href }) => (
        <li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}><span class="nav-bracket">[</span>{label}<span class="nav-bracket">]</span></a></li>
      ))}
      <li><a id="site-search-link" href={BASE + 'search/'} aria-current={isCurrent(BASE + 'search/') ? 'page' : undefined} aria-keyshortcuts="/"><span class="nav-bracket">[</span>поиск<span class="nav-bracket">]</span></a></li>
      <li class="needs-js">
        <details class="reader-settings">
          <summary title="Настройки чтения" aria-label="Настройки чтения"><Icon name="adjustments-horizontal" /></summary>
          <div class="reader-controls" role="group" aria-label="Настройки чтения">
            <button type="button" id="font-decrease" title="Уменьшить шрифт" aria-label="Уменьшить шрифт"><Icon name="minus" /></button>
            <button type="button" id="font-increase" title="Увеличить шрифт" aria-label="Увеличить шрифт"><Icon name="plus" /></button>
            <span class="flavor-row" role="group" aria-label="Банка для акцента">
              <button type="button" class="flavor-btn" data-flavor="original" data-tip="Monster Energy Original" aria-label="Акцент: Оригинал" aria-pressed="true"><span class="flavor-dot" aria-hidden="true"></span></button>
              <button type="button" class="flavor-btn" data-flavor="ultra-white" data-tip="Monster Ultra White" aria-label="Акцент: Ультра уайт" aria-pressed="false"><span class="flavor-dot" aria-hidden="true"></span></button>
              <button type="button" class="flavor-btn" data-flavor="khaos" data-tip="Monster Khaos" aria-label="Акцент: Хаос" aria-pressed="false"><span class="flavor-dot" aria-hidden="true"></span></button>
              <button type="button" class="flavor-btn" data-flavor="mango" data-tip="Monster Mango Loco" aria-label="Акцент: Манго Локо" aria-pressed="false"><span class="flavor-dot" aria-hidden="true"></span></button>
              <button type="button" class="flavor-btn" data-flavor="vr46" data-tip="Monster VR46 The Doctor" aria-label="Акцент: VR46" aria-pressed="false"><span class="flavor-dot" aria-hidden="true"></span></button>
              <button type="button" class="flavor-btn" data-flavor="ultra-black" data-tip="Monster Ultra Black" aria-label="Акцент: Ультра блэк" aria-pressed="false"><span class="flavor-dot" aria-hidden="true"></span></button>
            </span>
          </div>
        </details>
      </li>
    </ul>
    <span id="font-status" class="sr-only" aria-live="polite"></span>
  </nav>
</header>

<script>
  const settings = document.querySelector<HTMLDetailsElement>('.reader-settings');

  document.addEventListener('click', (event) => {
    if (settings?.open && event.target instanceof Node && !settings.contains(event.target)) settings.open = false;
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && settings?.open) {
      if (settings.contains(document.activeElement)) settings.querySelector('summary')?.focus();
      settings.open = false;
    }

    if (event.key !== '/' || event.ctrlKey || event.metaKey || event.altKey || event.isComposing) return;
    const target = event.target;
    if (target instanceof HTMLElement && (target.isContentEditable || target.closest('input, textarea, select'))) return;

    event.preventDefault();
    const input = document.getElementById('site-search-input');
    if (input) input.focus();
    else document.getElementById('site-search-link')?.click();
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: var(--app-z-navbar);
    border-bottom: 1px solid var(--pico-muted-border-color);
    color: var(--pico-color);
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    column-gap: var(--app-spacing);
    max-width: var(--app-reading-measure);
    margin-inline: auto;
    padding-inline: var(--app-page-gutter-start) var(--app-page-gutter-end);
    padding-block: var(--app-spacing-sm);
  }

  .site-nav ul {
    flex-wrap: wrap;
    column-gap: var(--app-spacing);
    margin: 0;
    padding: 0;
  }

  .site-nav li {
    display: block;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .site-nav a,
  .reader-settings summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--app-touch-target);
    margin: 0;
    padding: 0;
    color: inherit;
    text-decoration: none;
  }

  .site-nav a:hover,
  .reader-settings summary:hover,
  .reader-settings[open] summary {
    color: var(--pico-primary);
  }

  /* Текущая страница помечается только скобками: цвет — единственный сигнал,
     лишняя линия в шапке не нужна */
  .site-nav [aria-current="page"] .nav-bracket {
    color: var(--pico-primary);
  }

  .site-nav ul a {
    justify-content: center;
    min-width: var(--app-touch-target);
  }

  .site-brand {
    font-weight: 700;
  }

  .site-nav ul {
    font-size: var(--app-font-sm);
  }

  .reader-settings {
    position: relative;
    margin: 0;
  }

  .reader-settings summary {
    position: relative;
    justify-content: center;
    width: var(--app-touch-target);
    list-style: none;
  }

  .reader-settings summary::-webkit-details-marker,
  .reader-settings summary::after {
    display: none;
  }

  .reader-settings summary:focus-visible {
    outline: none;
  }

  .reader-settings summary:focus-visible::before {
    content: '';
    position: absolute;
    inset-block-end: var(--app-spacing-md);
    inset-inline: 0;
    width: var(--app-icon-size);
    margin-inline: auto;
    border-bottom: 2px solid var(--pico-primary);
  }

  .reader-controls {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-end: 0;
    flex-wrap: wrap;
    display: flex;
    /* Кнопки шрифта встают к правому краю, над банками: панель открывается от иконки справа */
    justify-content: flex-end;
    width: max-content;
    background: var(--pico-background-color);
    border: 1px solid var(--pico-muted-border-color);
    border-radius: var(--app-radius-sm);
  }

  /* Pico обводит [role="group"] кольцом, когда кнопка внутри в фокусе: после клика по банке
     панель и ряд банок вспыхивали рамкой. Клавиатурный фокус остаётся на самой кнопке */
  .reader-controls,
  .reader-controls [role="group"] {
    box-shadow: none !important;
  }

  .reader-controls button {
    display: grid;
    place-items: center;
    width: var(--app-touch-target);
    flex: 0 0 var(--app-touch-target);
    min-height: var(--app-touch-target);
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: var(--app-font-md);
  }

  .reader-controls button:hover {
    color: var(--pico-primary);
  }

  /* Банки из настроек чтения: кружок — вид банки сверху, не иконка */
  .flavor-row {
    display: flex;
    flex: 1 0 100%;
    justify-content: flex-end;
    border-top: 1px solid var(--pico-muted-border-color);
  }

  .flavor-btn {
    display: grid;
    place-items: center;
    width: var(--app-touch-target);
    height: var(--app-touch-target);
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .flavor-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
  }

  /* Рамок на банках нет: тёмный фон держит и светлую Ультру. Единственный маркер —
     тонкое кольцо у налитой банки; ховер без рамок, его отклик — всплывашка с именем.
     Зазор кольца пишем ночным значением напрямую: внутри <button> Pico подменяет
     --pico-background-color на цвет ховера, и кольцо вспыхивает цветным (см. комментарий в MindMap) */
  .flavor-btn[aria-pressed="true"] .flavor-dot {
    box-shadow: 0 0 0 2px #13171f, 0 0 0 3px var(--pico-muted-color);
  }

  .flavor-btn[data-flavor="original"] .flavor-dot { background: var(--app-flavor-original); }
  .flavor-btn[data-flavor="ultra-white"] .flavor-dot { background: var(--app-flavor-ultra-white); }
  .flavor-btn[data-flavor="khaos"] .flavor-dot { background: var(--app-flavor-khaos); }
  .flavor-btn[data-flavor="mango"] .flavor-dot { background: var(--app-flavor-mango); }
  .flavor-btn[data-flavor="vr46"] .flavor-dot { background: var(--app-flavor-vr46); }
  .flavor-btn[data-flavor="ultra-black"] .flavor-dot { background: var(--app-flavor-ultra-black); }

  @media (max-width: 640px) {
    .site-nav ul {
      font-size: var(--app-font-control);
      column-gap: var(--app-spacing-md);
    }

    /* Иконка настроек не помещалась к ссылкам и уходила одна на третью строку.
       Список растворяется в шапке: настройки встают рядом с «главной», ссылки ниже одной строкой */
    .site-nav ul {
      display: contents;
    }

    .site-brand { order: 0; }
    .site-nav li.needs-js { order: 1; }
    .site-nav::after {
      content: '';
      order: 2;
      flex-basis: 100%;
    }
    .site-nav li { order: 3; font-size: var(--app-font-control); }

    .reader-settings {
      position: static;
    }

    /* В одну строку панель шире телефона и уезжала за левый край: кнопки шрифта
       остаются сверху, шесть банок ложатся строкой под ними */
    .reader-controls {
      inset-inline-end: var(--app-page-gutter-end);
      width: calc(var(--app-touch-target) * 6 + 2px);
    }
  }

  @media (max-width: 500px) {
    .site-nav ul {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
