---
import Icon from './Icon.astro';
import { BASE, SITE } from '../config';

interface Props {
  hasAbout: boolean;
}

const { hasAbout } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => currentPath === href.replace(/\/$/, '');
const links = [
  { label: 'Архив', href: BASE + 'blog/' },
  { label: 'Заметки', href: BASE + 'notes/' },
  ...(hasAbout ? [{ label: 'Обо мне', href: BASE + 'about-me/' }] : []),
];
---

<header class="site-header">
  <nav class="site-nav" aria-label="Навигация по сайту">
    <a class="site-brand" href={BASE} aria-current={isCurrent(BASE) ? 'page' : undefined}>{SITE.author}</a>
    <ul role="list">
      {links.map(({ label, href }) => (
        <li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a></li>
      ))}
      <li><a id="site-search-link" href={BASE + 'search/'} aria-current={isCurrent(BASE + 'search/') ? 'page' : undefined} aria-keyshortcuts="/">Поиск</a></li>
      <li class="needs-js">
        <details class="reader-settings">
          <summary title="Настройки чтения" aria-label="Настройки чтения"><Icon name="adjustments-horizontal" /></summary>
          <div class="reader-controls" role="group" aria-label="Настройки чтения">
            <button type="button" id="font-decrease" title="Уменьшить шрифт" aria-label="Уменьшить шрифт"><Icon name="minus" /></button>
            <button type="button" id="font-increase" title="Увеличить шрифт" aria-label="Увеличить шрифт"><Icon name="plus" /></button>
            <button type="button" id="width-toggle" title="Ширина текста: обычная" aria-label="Ширина текста: обычная. Нажмите, чтобы сменить"><Icon name="width-normal" /></button>
            <button type="button" id="theme-toggle" title="Тёмная тема" aria-label="Тёмная тема" aria-pressed="false">
              <Icon name="sun" class="sun-icon" />
              <Icon name="moon" class="moon-icon" />
            </button>
          </div>
        </details>
      </li>
    </ul>
    <span id="font-status" class="sr-only" aria-live="polite"></span>
  </nav>
</header>

<script>
  const settings = document.querySelector<HTMLDetailsElement>('.reader-settings');

  document.addEventListener('click', (event) => {
    if (settings?.open && event.target instanceof Node && !settings.contains(event.target)) settings.open = false;
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && settings?.open) {
      if (settings.contains(document.activeElement)) settings.querySelector('summary')?.focus();
      settings.open = false;
    }

    if (event.key !== '/' || event.ctrlKey || event.metaKey || event.altKey || event.isComposing) return;
    const target = event.target;
    if (target instanceof HTMLElement && (target.isContentEditable || target.closest('input, textarea, select'))) return;

    event.preventDefault();
    const input = document.getElementById('site-search-input');
    if (input) input.focus();
    else document.getElementById('site-search-link')?.click();
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: var(--app-z-navbar);
    border-bottom: 1px solid var(--pico-muted-border-color);
    color: var(--pico-color);
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    column-gap: var(--app-spacing);
    max-width: var(--app-reading-measure);
    margin-inline: auto;
    padding-inline: var(--app-page-gutter-start) var(--app-page-gutter-end);
    padding-block: var(--app-spacing-sm);
  }

  .site-nav ul {
    flex-wrap: wrap;
    column-gap: var(--app-spacing);
    margin: 0;
    padding: 0;
  }

  .site-nav li {
    display: block;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .site-nav a,
  .reader-settings summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--app-touch-target);
    margin: 0;
    padding: 0;
    color: inherit;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav [aria-current="page"]:not(.site-brand),
  .reader-settings summary:hover,
  .reader-settings[open] summary {
    color: var(--pico-primary);
  }

  .site-nav ul [aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .site-nav ul a {
    justify-content: center;
    min-width: var(--app-touch-target);
  }

  .site-brand {
    font-weight: 700;
  }

  .site-nav ul {
    font-size: var(--app-font-sm);
  }

  .reader-settings {
    position: relative;
    margin: 0;
  }

  .reader-settings summary {
    position: relative;
    justify-content: center;
    width: var(--app-touch-target);
    list-style: none;
  }

  .reader-settings summary::-webkit-details-marker,
  .reader-settings summary::after {
    display: none;
  }

  .reader-settings summary:focus-visible {
    outline: none;
  }

  .reader-settings summary:focus-visible::before {
    content: '';
    position: absolute;
    inset-block-end: var(--app-spacing-md);
    inset-inline: 0;
    width: var(--app-icon-size);
    margin-inline: auto;
    border-bottom: 2px solid var(--pico-primary);
  }

  .reader-controls {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-end: 0;
    display: flex;
    width: max-content;
    background: var(--pico-background-color);
    border: 1px solid var(--pico-muted-border-color);
    border-radius: var(--app-radius-sm);
  }

  .reader-controls button {
    display: grid;
    place-items: center;
    width: var(--app-touch-target);
    flex: 0 0 var(--app-touch-target);
    min-height: var(--app-touch-target);
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: var(--app-font-md);
  }

  .reader-controls button:hover {
    color: var(--pico-primary);
  }

  .reader-controls :global(.sun-icon),
  :global(html[data-theme="dark"]) .reader-controls :global(.moon-icon) {
    display: none;
  }

  :global(html[data-theme="dark"]) .reader-controls :global(.sun-icon) {
    display: block;
  }

  @media (max-width: 640px) {
    .site-nav ul {
      font-size: var(--app-font-control);
      column-gap: var(--app-spacing-md);
    }

    .reader-settings {
      position: static;
    }

    .reader-controls {
      inset-inline-end: var(--app-page-gutter-end);
    }
  }
</style>
