---
import Layout from '../layouts/Layout.astro';
import { formatDate } from '../utils/date';

interface Props {
  entry: { data: { title: string; date: Date; summary?: string }; fileLabel: string } | null;
  fallbackTitle: string;
  fallbackH1: string;
  prompt: string;
}

const { entry, fallbackTitle, fallbackH1 } = Astro.props;
const hasEntry = !!entry;
---

<Layout title={hasEntry ? entry.data.title : fallbackTitle} description={hasEntry ? entry.data.summary : undefined}>
  <article>
    <div class="entry-header">
      {hasEntry ? (
        <>
          <p class="meta"><span>{formatDate(entry.data.date)}</span><span class="meta-sep" aria-hidden="true">~</span><span>{entry.fileLabel}</span></p>
          <hgroup>
            <h1>{entry.data.title}</h1>
            {entry.data.summary && <p class="summary">{entry.data.summary}</p>}
          </hgroup>
        </>
      ) : (
        <h1>{fallbackH1}</h1>
      )}
    </div>
    <div class="content">
      <slot />
    </div>
  </article>
</Layout>
