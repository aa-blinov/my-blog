---
import Layout from '../layouts/Layout.astro';
import { formatDate, humanDate } from '../utils/date';

interface Props {
  entry: { data: { title: string; date: Date; summary?: string }; fileLabel: string } | null;
  fallbackTitle: string;
  fallbackH1: string;
  prompt: string;
  hideHeader?: boolean;
  hideMeta?: boolean;
  description?: string;
}

const { entry, fallbackTitle, fallbackH1, hideHeader = false, hideMeta = false, description } = Astro.props;
const hasEntry = !!entry;
---

<Layout title={hasEntry ? entry.data.title : fallbackTitle} description={description ?? (hasEntry ? entry.data.summary : undefined)}>
  <article>
    {!hideHeader && <div class="entry-header">
      {hasEntry ? (
        <>
          {!hideMeta && <p class="meta"><time datetime={formatDate(entry.data.date)}>{humanDate(entry.data.date)}</time></p>}
          <hgroup>
            <h1>{entry.data.title}</h1>
            {entry.data.summary && <p class="summary">{entry.data.summary}</p>}
          </hgroup>
        </>
      ) : (
        <h1>{fallbackH1}</h1>
      )}
    </div>}
    <div class="content">
      <slot />
    </div>
  </article>
</Layout>
