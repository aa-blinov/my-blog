---
import type { Series, BlogEntry } from '../utils/series';
import { BASE } from '../config';
import Arrow from './Arrow.astro';

interface Props {
  series: Series;
  entry: BlogEntry;
  where: 'head' | 'foot';
}

const { series, entry, where } = Astro.props;
const idx = series.parts.findIndex((p) => p.id === entry.id);
const prev = idx > 0 ? series.parts[idx - 1] : null;
const next = idx >= 0 && idx < series.parts.length - 1 ? series.parts[idx + 1] : null;
const href = (e: BlogEntry) => `${BASE}blog/${e.id}/`;
const tocHref = `${BASE}blog/${series.folder}/`;
---

{where === 'head' ? (
  <p class="series-line">
    <span>Серия <a href={tocHref}>«{series.title}»</a></span>
    <span class="meta-sep" aria-hidden="true">~</span>
    <span>часть {entry.data.part} из {series.parts.length}</span>
  </p>
) : (
  <nav class="series-nav" id="series-nav" aria-label="Навигация по серии">
    {prev ? (
      <a href={href(prev)} class="series-prev" rel="prev"><span class="series-label"><Arrow dir="left" size={14} /> часть {prev.data.part}</span>{prev.data.title}</a>
    ) : (
      <a href={tocHref} class="series-prev"><span class="series-label"><Arrow dir="left" size={14} /> серия</span>Оглавление</a>
    )}
    {next ? (
      <a href={href(next)} class="series-next" rel="next"><span class="series-label">часть {next.data.part} <Arrow dir="right" size={14} /></span>{next.data.title}</a>
    ) : (
      <a href={tocHref} class="series-next"><span class="series-label">серия <Arrow dir="right" size={14} /></span>Оглавление</a>
    )}
  </nav>
  <script is:inline>
    // Источники это приложение, а не конец повествования: ссылки на соседние части встают перед ними
    (function () {
      var nav = document.getElementById('series-nav');
      var heads = document.querySelectorAll('.content h2');
      for (var i = 0; i < heads.length; i++) {
        if (/^Список источников/.test(heads[i].textContent.trim())) { heads[i].parentNode.insertBefore(nav, heads[i]); break; }
      }
    })();
  </script>
)}
