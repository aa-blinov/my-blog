---
import { BASE } from '../config';
import { formatDate } from '../utils/date';

interface BlogEntry {
  id: string;
  slug: string;
  title: string;
  date: Date;
  section?: string;
  part?: number;
}

interface Props {
  blogEntries: BlogEntry[];
  mainEntry?: { slug: string; title: string; date: Date } | null;
  aboutEntry?: { slug: string; title: string; date: Date } | null;
  notesEntry?: { slug: string; title: string; date: Date } | null;
}

const { blogEntries, mainEntry, aboutEntry, notesEntry } = Astro.props;

// --- Tree Building ---
interface TreeNode {
  name: string;
  kind: 'file' | 'folder';
  children?: Record<string, TreeNode>;
  entry?: BlogEntry;
  minDate?: Date;
  maxDate?: Date;
  fullPath?: string;
}

const root: TreeNode = { name: 'blog', kind: 'folder', children: {}, fullPath: '' };

blogEntries.forEach((entry) => {
  // Use frontmatter section as virtual path or fall back to physical path
  const path = entry.section ? `${entry.section}/${entry.id.split('/').pop()}` : entry.id;
  const parts = path.split('/');
  let current = root;

  parts.forEach((part, i) => {
    if (i === parts.length - 1) {
      // It's a file
      current.children![part] = { name: part, kind: 'file', entry };
    } else {
      // It's a folder
      if (!current.children![part]) {
        const folderPath = parts.slice(0, i + 1).join('/');
        current.children![part] = { name: part, kind: 'folder', children: {}, fullPath: folderPath };
      }
      current = current.children![part];
    }
  });
});

// --- Recursive Stats Calculation ---
function calculateStats(node: TreeNode) {
  if (node.kind === 'file') {
    node.minDate = node.entry?.date;
    node.maxDate = node.entry?.date;
    return;
  }

  let min: number | null = null;
  let max: number | null = null;

  Object.values(node.children || {}).forEach((child) => {
    calculateStats(child);
    if (child.minDate) {
      const t = child.minDate.getTime();
      if (min === null || t < min) min = t;
      if (max === null || t > max) max = t;
    }
    if (child.maxDate) {
      const t = child.maxDate.getTime();
      if (min === null || t < min) min = t;
      if (max === null || t > max) max = t;
    }
  });

  if (min !== null) node.minDate = new Date(min);
  if (max !== null) node.maxDate = new Date(max);
}
calculateStats(root);

// Determine active path
const currentPath = Astro.url.pathname;
function isActive(href: string): boolean {
  const normalize = (p: string) => p.endsWith('/') ? p : p + '/';
  return normalize(currentPath) === normalize(href);
}

// Папка раскрыта, если в ней лежит текущая страница; корень blog/ раскрыт всегда
function isOnActivePath(fullPath: string): boolean {
  if (!fullPath) return true;
  const p = currentPath.endsWith('/') ? currentPath : currentPath + '/';
  return p.startsWith(`${BASE}blog/${fullPath}/`);
}

// В дереве заголовок до первого «: »: у научпопа после двоеточия идёт подзаголовок, он отрезался многоточием
function shortTitle(title: string): string {
  const clean = title.replace(/:\s*Об этой секции$/, '');
  const i = clean.indexOf(': ');
  return i > 0 ? clean.slice(0, i) : clean;
}

function getFolderHref(fullPath: string) {
  const cleanPath = fullPath ? `${fullPath}/` : '';
  return `${BASE}blog/${cleanPath}`;
}
---

<nav class="sidebar-nav">
  <div class="sidebar-controls">
    <span class="search-field">
      <input
        type="text"
        id="sidebar-search"
        placeholder="search..."
        autocomplete="off"
        aria-label="Поиск по названию и имени файла"
      />
      <button id="sidebar-search-clear" class="search-clear" type="button" aria-label="Очистить поиск" hidden>×</button>
    </span>
    <button id="sort-date-btn" class="sort-btn" title="Новые сверху" aria-label="Новые сверху" aria-pressed="false" data-label="новые">
      <span class="sort-icon" aria-hidden="true">↓</span>
    </button>
  </div>
  <p id="sidebar-empty" class="sidebar-empty" role="status" hidden>ничего не найдено. Ищу по названию и имени файла, попробуй другое слово</p>
  <p id="sidebar-count" class="sidebar-empty" role="status" hidden></p>

  <ul id="sidebar-tree" class="sortable-list" data-sort="desc">
    {mainEntry && (
      <li class="sidebar-pinned" data-filename="main.md" data-title={mainEntry.title.toLowerCase()} data-date={mainEntry.date.toISOString()}>
        <span class="file-link-wrapper">
          <a href={BASE} class:list={['file-link', { active: isActive(BASE) }]}>
            <span class="file-name" title="main.md">{mainEntry.title}</span>
          </a>
        </span>
      </li>
    )}
    {aboutEntry && (
      <li class="sidebar-pinned" data-filename="about-me.md" data-title={aboutEntry.title.toLowerCase()} data-date={aboutEntry.date.toISOString()}>
        <span class="file-link-wrapper">
          <a href={`${BASE}about-me/`} class:list={['file-link', { active: isActive(`${BASE}about-me/`) }]}>
            <span class="file-name" title="about-me.md">{aboutEntry.title}</span>
          </a>
        </span>
      </li>
    )}
    {notesEntry && (
      <li class="sidebar-pinned" data-filename="notes.md" data-title={notesEntry.title.toLowerCase()} data-date={notesEntry.date.toISOString()}>
        <span class="file-link-wrapper">
          <a href={`${BASE}notes/`} class:list={['file-link', { active: isActive(`${BASE}notes/`) }]}>
            <span class="file-name" title="notes.md">{notesEntry.title}</span>
          </a>
        </span>
        <span class="file-date">{formatDate(notesEntry.date)}</span>
      </li>
    )}
    
    {/* Рекурсивный рендеринг дерева */}
    {function renderTree(node: TreeNode) {
      // Папка-серия (у детей есть part): части по номеру, about-* сверху; иначе по алфавиту
      const isSeriesFolder = node.kind === 'folder' && Object.values(node.children || {}).some((c) => c.entry?.part !== undefined);
      const childrenArr = Object.values(node.children || {}).sort((a, b) =>
        isSeriesFolder ? (a.entry?.part ?? -1) - (b.entry?.part ?? -1) : a.name.localeCompare(b.name),
      );
      
      // Calculate order values for CSS. 
      // We use timestamps in seconds to keep them within safe integer range for CSS.
      // desc: higher date = smaller order value
      // asc: lower date = smaller order value
      const isSectionRootFile = node.kind === 'file' && node.name.startsWith('about-');
      const orderPinTop = -9999999999; // «обзор раздела» (about-*.md) всегда сверху в своей папке
      const partOrder = node.kind === 'file' && node.entry?.part !== undefined ? node.entry.part : null; // часть серии не перемешивается сортировкой по дате
      const dateVal = node.entry?.date.getTime() || 0;
      const minDateVal = node.minDate?.getTime() || 0;
      const maxDateVal = node.maxDate?.getTime() || 0;
      
      return (
        <li 
          class:list={[{ 'folder-item': node.kind === 'folder', 'sortable-item': true }]} 
          style={{
            '--order-desc': isSectionRootFile ? orderPinTop : partOrder ?? (node.kind === 'file' ? -Math.floor(dateVal / 100000) : -Math.floor(maxDateVal / 100000)),
            '--order-asc': isSectionRootFile ? orderPinTop : partOrder ?? (node.kind === 'file' ? Math.floor(dateVal / 100000) : Math.floor(minDateVal / 100000))
          }}
          data-date-min={node.minDate?.toISOString()} 
          data-date-max={node.maxDate?.toISOString()}
          {...(node.kind === 'file' ? { 
            'data-filename': node.name, 
            'data-title': node.entry?.title.toLowerCase(),
            'data-date': node.entry?.date.toISOString() 
          } : {})}
        >
          {node.kind === 'folder' ? (
            <details open={isOnActivePath(node.fullPath || '')} data-default-open={isOnActivePath(node.fullPath || '') ? 'true' : 'false'}>
              <summary class="contrast">
                <span class="ascii-icon folder">▸</span>
                <a 
                  href={getFolderHref(node.fullPath || '')} 
                  class:list={['folder-link', { active: isActive(getFolderHref(node.fullPath || '')) }]}
                >
                  {node.name}/
                </a>
                <a href={getFolderHref(node.fullPath || '')} class="folder-open" aria-label={`Раздел ${node.name}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="18" height="18" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </summary>
              <ul class="sortable-list">
                {childrenArr.map(child => renderTree(child))}
              </ul>
            </details>
          ) : (
            <>
              <span class="file-link-wrapper">
                <a href={`${BASE}blog/${node.entry?.slug}/`} class:list={['file-link', { active: isActive(`${BASE}blog/${node.entry?.slug}/`) }]}>
                        <span class="file-name" title={`${node.entry?.title.replace(/:\s*Об этой секции$/, '')} (${node.name})`} data-short={shortTitle(node.entry?.title ?? '')} data-full={node.entry?.title.replace(/:\s*Об этой секции$/, '')}>{shortTitle(node.entry?.title ?? '')}</span>
                </a>
              </span>
              <span class="file-date">{formatDate(node.entry!.date)}</span>
            </>
          )}
        </li>
      );
    }(root)}
  </ul>

  <!-- Synchronous state restoration to prevent blinking -->
  <script is:inline>
    (function() {
      const tree = document.getElementById('sidebar-tree');
      const sortBtn = document.getElementById('sort-date-btn');
      const searchInput = document.getElementById('sidebar-search');
      if (!tree || !sortBtn || !searchInput) return;

      try {
        // --- Restore Sort State ---
        // По умолчанию новые сверху (в разметке); из хранилища только отличие от умолчания
        const sortOrder = localStorage.getItem('sidebar-sort') || 'desc';
        if (sortOrder !== 'desc') {
          if (sortOrder === 'none') tree.removeAttribute('data-sort'); else tree.setAttribute('data-sort', sortOrder);
          const icon = sortBtn.querySelector('.sort-icon');
          if (icon) {
            if (sortOrder === 'none') {
              icon.textContent = '↕';
              sortBtn.setAttribute('title', 'По разделам и имени');
              sortBtn.setAttribute('aria-label', 'По разделам и имени');
              sortBtn.setAttribute('aria-pressed', 'true');
              sortBtn.classList.add('active');
              sortBtn.setAttribute('data-label', 'по имени');
            } else if (sortOrder === 'asc') {
              icon.textContent = '↑';
              sortBtn.setAttribute('title', 'Старые сверху');
              sortBtn.setAttribute('aria-label', 'Старые сверху');
              sortBtn.setAttribute('aria-pressed', 'true');
              sortBtn.classList.add('active');
              sortBtn.setAttribute('data-label', 'старые');
            }
          }
        }

        // --- Restore Search State ---
        const searchRaw = sessionStorage.getItem('sidebar-search');
        if (searchRaw) {
          const raw = searchRaw.toLowerCase().trim();
          searchInput.value = searchRaw; // Restore input value
          const clearBtn = document.getElementById('sidebar-search-clear');
          if (clearBtn) clearBtn.hidden = !raw;
          if (raw) {
            const ruToEn = {
              'а':'a','б':'b','в':'v','г':'g','д':'d','е':'e','ё':'yo',
              'ж':'zh','з':'z','и':'i','й':'y','к':'k','л':'l','м':'m',
              'н':'n','о':'o','п':'p','р':'r','с':'s','т':'t','у':'u',
              'ф':'f','х':'kh','ц':'ts','ч':'ch','ш':'sh','щ':'shch',
              'ъ':'','ы':'y','ь':'','э':'e','ю':'yu','я':'ya',
              ' ':'-'
            };
            const transliterate = (text) => text.split('').map(c => ruToEn[c] ?? c).join('');
            const hasRussian = (text) => /[а-яё]/i.test(text);

            const allFileItems = tree.querySelectorAll('li[data-filename]');
            const allFolderItems = tree.querySelectorAll('li.folder-item');
            
            const queries = [raw];
            if (hasRussian(raw)) queries.push(transliterate(raw));
            
            allFileItems.forEach(li => {
              const name = (li.getAttribute('data-filename') || '').toLowerCase();
              const title = (li.getAttribute('data-title') || '').toLowerCase();
              li.style.display = queries.some(q => name.includes(q)) || title.includes(raw) ? '' : 'none';
            });
            allFolderItems.forEach(folder => {
              const visibleFiles = folder.querySelectorAll('li[data-filename]:not([style*="display: none"])');
              folder.style.display = visibleFiles.length > 0 ? '' : 'none';
              const details = folder.querySelector('details');
              if (details && visibleFiles.length > 0) details.open = true;
            });
            const shown = tree.querySelectorAll('li[data-filename]:not([style*="display: none"])').length;
            const empty = document.getElementById('sidebar-empty');
            if (empty) empty.hidden = shown > 0;
            const count = document.getElementById('sidebar-count');
            if (count) { count.hidden = shown === 0; count.textContent = 'показано ' + shown + ' из ' + allFileItems.length; }
            // В результатах полный заголовок: видно, чем совпало
            tree.querySelectorAll('.file-name[data-full]').forEach(n => { n.textContent = n.getAttribute('data-full'); });
          }
        }
      } catch (e) {
        // Ignore localStorage or other early errors
      }
    })();
  </script>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('sidebar-search') as HTMLInputElement;
    const clearBtn = document.getElementById('sidebar-search-clear') as HTMLButtonElement | null;
    const sortBtn = document.getElementById('sort-date-btn');
    const tree = document.getElementById('sidebar-tree');
    if (!searchInput || !sortBtn || !tree) return;

    // --- Имя папки везде раскрывает папку, в раздел ведёт стрелка справа: одна модель на всех ширинах ---
    tree.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const folderLink = target.closest('.folder-link');
      if (!folderLink) return;
      e.preventDefault();
      const details = folderLink.closest('details');
      if (details) details.open = !details.open;
      e.stopImmediatePropagation();
    }, true);

    // --- Транслитерация ---
    const ruToEn: Record<string, string> = {
      'а':'a','б':'b','в':'v','г':'g','д':'d','е':'e','ё':'yo',
      'ж':'zh','з':'z','и':'i','й':'y','к':'k','л':'l','м':'m',
      'н':'n','о':'o','п':'p','р':'r','с':'s','т':'t','у':'u',
      'ф':'f','х':'kh','ц':'ts','ч':'ch','ш':'sh','щ':'shch',
      'ъ':'','ы':'y','ь':'','э':'e','ю':'yu','я':'ya',
      ' ':'-'
    };
    function transliterate(text: string): string { return text.split('').map(c => ruToEn[c] ?? c).join(''); }
    function hasRussian(text: string): boolean { return /[а-яё]/i.test(text); }

    // --- Поиск ---
    function performSearch() {
      const raw = searchInput.value.toLowerCase().trim();
      const allFileItems = tree!.querySelectorAll<HTMLLIElement>('li[data-filename]');
      const allFolderItems = tree!.querySelectorAll<HTMLLIElement>('li.folder-item');
      
      // Фильтр живёт в рамках вкладки: на следующий день дерево снова целое
      sessionStorage.setItem('sidebar-search', raw);
      if (clearBtn) clearBtn.hidden = !raw;

      const empty = document.getElementById('sidebar-empty');
      const count = document.getElementById('sidebar-count');
      if (!raw) {
        allFileItems.forEach(li => li.style.display = '');
        allFolderItems.forEach(li => li.style.display = '');
        // Папки возвращаются к исходному раскрытию, заголовки к короткой форме
        tree!.querySelectorAll<HTMLDetailsElement>('details[data-default-open]').forEach(d => { d.open = d.dataset.defaultOpen === 'true'; });
        tree!.querySelectorAll<HTMLElement>('.file-name[data-short]').forEach(n => { n.textContent = n.dataset.short ?? ''; });
        if (empty) empty.hidden = true;
        if (count) count.hidden = true;
        return;
      }
      // В результатах полный заголовок с подзаголовком: видно, чем совпало
      tree!.querySelectorAll<HTMLElement>('.file-name[data-full]').forEach(n => { n.textContent = n.dataset.full ?? ''; });
      const queries = [raw];
      if (hasRussian(raw)) queries.push(transliterate(raw));
      allFileItems.forEach(li => {
        const name = (li.getAttribute('data-filename') || '').toLowerCase();
        const title = (li.getAttribute('data-title') || '').toLowerCase();
        li.style.display = queries.some(q => name.includes(q)) || title.includes(raw) ? '' : 'none';
      });
      allFolderItems.forEach(folder => {
        const visibleFiles = folder.querySelectorAll<HTMLLIElement>('li[data-filename]:not([style*="display: none"])');
        folder.style.display = visibleFiles.length > 0 ? '' : 'none';
        const details = folder.querySelector('details');
        if (details && visibleFiles.length > 0) details.open = true;
      });
      const shown = tree!.querySelectorAll('li[data-filename]:not([style*="display: none"])').length;
      if (empty) empty.hidden = shown > 0;
      if (count) { count.hidden = shown === 0; count.textContent = `показано ${shown} из ${allFileItems.length}`; }
    }

    searchInput.addEventListener('input', performSearch);

    // --- Текущий файл виден сразу: в sticky-дереве на десктопе и в оверлее на мобиле ---
    function revealActive() {
      const active = tree!.querySelector<HTMLElement>('.file-link.active, .folder-link.active');
      const box = document.getElementById('layout-sidebar');
      if (!active || !box) return;
      const a = active.getBoundingClientRect();
      const b = box.getBoundingClientRect();
      if (a.top < b.top || a.bottom > b.bottom) {
        box.scrollTop += a.top - b.top - b.height / 3;
      }
    }
    revealActive();
    window.addEventListener('sidebar-state-changed', () => requestAnimationFrame(revealActive));
    clearBtn?.addEventListener('click', () => {
      searchInput.value = '';
      performSearch();
      searchInput.focus();
    });
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && searchInput.value) {
        e.stopPropagation();
        searchInput.value = '';
        performSearch();
      }
    });

    // --- Закрытие сайдбара при клике на мобилках ---
    tree.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const link = target.closest('a');
      if (link && window.innerWidth < 992) {
        const sidebar = document.getElementById('layout-sidebar');
        if (sidebar && sidebar.classList.contains('sidebar-shown')) {
          sidebar.classList.remove('sidebar-shown');
          window.dispatchEvent(new CustomEvent('sidebar-state-changed'));
        }
      }
    });

    // --- Сортировка ---
    type SortOrder = 'none' | 'desc' | 'asc';
    let sortOrder: SortOrder = (localStorage.getItem('sidebar-sort') as SortOrder) || 'desc';
    const sortIcon = sortBtn.querySelector('.sort-icon') as HTMLSpanElement;
    const sortStates: Record<SortOrder, { icon: string; title: string; label: string }> = {
      'none': { icon: '↕', title: 'По разделам и имени', label: 'по имени' },
      'desc': { icon: '↓', title: 'Новые сверху', label: 'новые' },
      'asc':  { icon: '↑', title: 'Старые сверху', label: 'старые' },
    };

    function updateSortUI() {
      const state = sortStates[sortOrder];
      sortIcon.textContent = state.icon;
      sortBtn!.setAttribute('title', state.title);
      sortBtn!.setAttribute('aria-label', state.title);
      // Умолчание «новые сверху» не подсвечивается: зелёный только у отличия от него
      sortBtn!.setAttribute('aria-pressed', sortOrder === 'desc' ? 'false' : 'true');
      sortBtn!.classList.toggle('active', sortOrder !== 'desc');
      sortBtn!.setAttribute('data-label', state.label);
      
      // Update global sort attribute on the list for CSS sorting
      if (sortOrder === 'none') tree!.removeAttribute('data-sort'); else tree!.setAttribute('data-sort', sortOrder);
    }

    sortBtn.addEventListener('click', () => {
      if (sortOrder === 'desc') sortOrder = 'asc';
      else if (sortOrder === 'asc') sortOrder = 'none';
      else sortOrder = 'desc';
      localStorage.setItem('sidebar-sort', sortOrder);
      updateSortUI();
    });
  });
</script>

<style>
  /* --- Панель поиска и сортировки --- */
  .sidebar-controls {
    display: flex;
    align-items: stretch;
    gap: 0.3rem;
    margin-bottom: 0.4rem;
    font-family: var(--font-family);
  }

  .search-field {
    flex: 1;
    position: relative;
    display: flex;
    min-width: 0;
  }
  .search-clear {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 1.6rem;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    color: var(--pico-muted-color);
    font-family: inherit;
    font-size: var(--app-font-lg);
    line-height: 1;
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .search-clear:hover {
    color: var(--pico-primary);
  }
  .search-clear[hidden] {
    display: none;
  }
  .sidebar-controls input {
    flex: 1;
    width: 100%;
    padding-right: 1.6rem;
    font-size: var(--app-font-control);
    font-family: inherit;
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--pico-muted-border-color);
    border-radius: 3px;
    background: transparent;
    color: var(--pico-color);
    outline: none;
    margin: 0;
    line-height: 1;
    height: auto;
    box-sizing: border-box;
  }

  .sidebar-controls input::placeholder {
    color: var(--pico-muted-color);
    opacity: 1; /* Ink Muted проходит 4.5:1 только без прозрачности */
  }

  .sidebar-controls input:focus {
    border-color: var(--pico-primary);
  }

  .sort-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    background-color: transparent;
    border: 1px solid var(--pico-muted-border-color);
    border-radius: 3px;
    color: var(--pico-muted-color);
    cursor: pointer;
    padding: 0 0.35rem;
    font-size: var(--app-font-control);
    line-height: 1;
    transition: color 0.15s ease, border-color 0.15s ease;
    margin: 0;
    height: auto;
    width: auto;
    min-width: 24px;
    min-height: 24px;
    font-family: inherit;
    box-shadow: none;
    box-sizing: border-box;
  }

  .sort-btn:hover {
    color: var(--pico-primary);
    border-color: var(--pico-primary);
    background: transparent;
  }

  .sort-btn.active {
    color: var(--pico-primary);
    border-color: var(--pico-primary);
    background: transparent;
  }

  .sort-btn[data-label]::after {
    content: attr(data-label);
    margin-left: 0.15rem;
    font-size: var(--app-font-caption);
    opacity: 0.8;
  }

  .sidebar-empty {
    margin: 0.4rem 0 0;
    font-size: inherit;
    color: var(--pico-muted-color);
  }
  .sidebar-empty[hidden] {
    display: none;
  }

  /* --- Дерево файлов --- */
  .sidebar-nav {
    position: relative;
