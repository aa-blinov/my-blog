---
import { render, type CollectionEntry } from 'astro:content';
import { formatDate, formatTime, noteAnchor } from '../utils/date';
import { BASE } from '../config';

interface Props {
  notes: CollectionEntry<'notes'>[];
}

const { notes } = Astro.props;
const rendered = await Promise.all(notes.map(async (note) => ({ note, Content: (await render(note)).Content })));
---

<div class="note-list">
  {rendered.map(({ note, Content }) => {
    const id = noteAnchor(note.data.date);
    return (
      <article class="note" id={id}>
        <p class="note-meta">
          <a href={`${BASE}notes/#${id}`} class="note-anchor" title="Ссылка на заметку">
            <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)} <span class="meta-sep" aria-hidden="true">~</span> {formatTime(note.data.date)}</time>
          </a>
        </p>
        <div class="content note-body">
          <Content />
        </div>
      </article>
    );
  })}
</div>
