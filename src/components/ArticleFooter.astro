---
import { getCollection, type CollectionEntry } from 'astro:content';
import { sortByDateDesc } from '../utils/date';
import { BASE, sectionPagePath, sectionTitle } from '../config';
import PostList from './PostList.astro';
import Arrow from './Arrow.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
  inSeries: boolean; // у частей серии уже есть prev/next, соседей по разделу не показываем
}

const { entry, inSeries } = Astro.props;
const isAbout = (id: string) => id.split('/').pop()!.startsWith('about-');
const folder = entry.id.slice(0, entry.id.lastIndexOf('/'));
const all = (await getCollection('blog')).filter((e) => !e.data.draft && !isAbout(e.id) && e.id !== entry.id);
// Соседи из своей папки; если она почти пуста, из верхнего раздела
const inFolder = all.filter((e) => e.id.startsWith(folder + '/'));
const top = entry.id.split('/')[0];
const pool = inFolder.length >= 2 ? inFolder : all.filter((e) => e.id.startsWith(top + '/'));
const poolFolder = inFolder.length >= 2 ? folder : top;
const more = inSeries || isAbout(entry.id) ? [] : sortByDateDesc(pool).slice(0, 3);
const sectionPath = sectionPagePath(poolFolder);
const folderName = sectionPath.split('/').pop()!;
const about = (await getCollection('blog')).find((e) => e.id === `${sectionPath}/about-${folderName}`);
const folderTitle = about?.data.title.replace(/:\s*Об этой секции$/, '') ?? sectionTitle(folderName);
---

{more.length > 0 && (
  <aside class="article-footer" aria-label="После статьи">
    <section class="more-in-section">
      <h2 class="section-heading">Ещё в разделе «{folderTitle}» <span class="section-slug">{sectionPath}/</span></h2>
      <PostList posts={more} />
      <p class="all-articles"><a href={`${BASE}blog/${sectionPath}/`} class="post-title-link all-articles-link">Весь раздел <Arrow /></a></p>
    </section>
  </aside>
)}
