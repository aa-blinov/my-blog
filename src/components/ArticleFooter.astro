---
import { getCollection, type CollectionEntry } from 'astro:content';
import { sortByDateDesc } from '../utils/date';
import { BASE, SITE, sectionTitle } from '../config';
import PostList from './PostList.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
  inSeries: boolean; // у частей серии уже есть prev/next, соседей по разделу не показываем
}

const { entry, inSeries } = Astro.props;
const top = entry.id.split('/')[0];
const isAbout = entry.id.split('/').pop()!.startsWith('about-');
const more = inSeries || isAbout
  ? []
  : sortByDateDesc(
      (await getCollection('blog')).filter(
        (e) => !e.data.draft && e.id !== entry.id && e.id.startsWith(top + '/') && !e.id.split('/').pop()!.startsWith('about-'),
      ),
    ).slice(0, 3);
---

<aside class="article-footer" aria-label="После статьи">
  {more.length > 0 && (
    <section class="more-in-section">
      <h2 class="section-heading">Ещё в разделе «{sectionTitle(top)}» <span class="section-slug">{top}/</span></h2>
      <PostList posts={more} />
      <p class="all-articles"><a href={`${BASE}blog/${top}/`} class="post-title-link all-articles-link">Весь раздел &rarr;</a></p>
    </section>
  )}
  <p class="author-line">
    <span>{SITE.author}, руководитель разработки в EORA.</span>
    <a href={`${BASE}about-me/`}>Обо мне</a>
    <span class="meta-sep" aria-hidden="true">~</span>
    <a href={`${BASE}notes/`}>Заметки</a>
    <span class="meta-sep" aria-hidden="true">~</span>
    <a href={`${BASE}rss.xml`}>RSS</a>
  </p>
</aside>
