---
import { formatDate, humanDate, readingMinutes, plural } from '../utils/date';
import { BASE } from '../config';
// Описание есть у малой части статей, а заголовки образные: без первых строк текста
// по списку раздела не понять, о чём статья
import { articleSummary } from '../utils/article-summary';

interface Props {
  posts: { id: string; body?: string; data: { title: string; date: Date; section?: string; summary?: string; part?: number } }[];
  numbered?: boolean; // серия: номер части перед датой
  level?: 2 | 3; // уровень заголовка статьи: 2, когда над списком нет своего h2, иначе после h1 сразу h3
}

const { posts, numbered = false, level = 3 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
---

<div class="post-list">
  {posts.length === 0 ? (
    <p>Пока ничего нет.</p>
  ) : (
    posts.map((entry) => (
      <div class="post-list-item">
        <p class="meta">{numbered && entry.data.part !== undefined ? (
          // Серия: номер и время чтения; одинаковые даты здесь только шумели. Имя файла читателю научпопа
          // ничего не говорило и выглядело как служебная страница, открытая по ошибке
          <><span>часть {entry.data.part}</span>{entry.body && <><span class="meta-sep" aria-hidden="true">~</span><span>≈ {readingMinutes(entry.body)} {plural(readingMinutes(entry.body), 'минута', 'минуты', 'минут')}</span></>}</>
        ) : (
          <><time datetime={formatDate(entry.data.date)}>{humanDate(entry.data.date)}</time>{entry.body && <><span class="meta-sep" aria-hidden="true">~</span><span>≈ {readingMinutes(entry.body)} {plural(readingMinutes(entry.body), 'минута', 'минуты', 'минут')}</span></>}</>
        )}</p>
        <Heading class="post-title">
          <a href={`${BASE}blog/${entry.id}/`} class="post-title-link">
            {entry.data.title}
          </a>
        </Heading>
        {articleSummary(entry) && <p class="summary">{articleSummary(entry)}</p>}
      </div>
    ))
  )}
</div>
