---
import { formatDate } from '../utils/date';
import { BASE } from '../config';

interface Props {
  posts: { id: string; data: { title: string; date: Date; section?: string; summary?: string } }[];
}

const { posts } = Astro.props;
---

<div class="post-list">
  {posts.length === 0 ? (
    <p>Пока ничего нет.</p>
  ) : (
    posts.map((entry) => (
      <div class="post-list-item">
        <p class="meta">{formatDate(entry.data.date)} · {entry.id}.md</p>
        <h3>
          <a href={`${BASE}blog/${entry.id}/`} class="post-title-link">
            {entry.data.title}
          </a>
        </h3>
        {entry.data.summary && <p class="summary">{entry.data.summary}</p>}
      </div>
    ))
  )}
</div>


