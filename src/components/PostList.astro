---
import { formatDate, excerpt } from '../utils/date';
import { BASE } from '../config';

interface Props {
  posts: { id: string; body?: string; data: { title: string; date: Date; section?: string; summary?: string; part?: number } }[];
  numbered?: boolean; // серия: номер части перед датой
  excerpts?: boolean; // главная: первая строка текста под заголовком
}

const { posts, numbered = false, excerpts = false } = Astro.props;
---

<div class="post-list">
  {posts.length === 0 ? (
    <p>Пока ничего нет.</p>
  ) : (
    posts.map((entry) => (
      <div class="post-list-item">
        <p class="meta">{numbered && entry.data.part !== undefined && <><span>часть {entry.data.part}</span><span class="meta-sep" aria-hidden="true">~</span></>}<span>{formatDate(entry.data.date)}</span><span class="meta-sep" aria-hidden="true">~</span><span class="meta-path">{entry.id}.md</span><span class="meta-file">{entry.id.split('/').pop()}.md</span></p>
        <h3>
          <a href={`${BASE}blog/${entry.id}/`} class="post-title-link">
            {entry.data.title}
          </a>
        </h3>
        {entry.data.summary ? <p class="summary">{entry.data.summary}</p> : excerpts && entry.body && <p class="summary">{excerpt(entry.body)}</p>}
      </div>
    ))
  )}
</div>


