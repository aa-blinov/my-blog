---
import Layout from '../layouts/Layout.astro';
import { BASE } from '../config';
---

<Layout title="Файла нет" description="Такой страницы нет. Поищите статью по названию или вернитесь на главную">
  <article>
    <div class="entry-header">
      <p class="meta"><span>404</span><span class="meta-sep" aria-hidden="true">~</span><span id="missing-path">file not found</span></p>
      <hgroup>
        <h1>Такого файла нет</h1>
        <p class="summary">Ссылка устарела или в адресе опечатка.</p>
      </hgroup>
    </div>
    <div class="content">
      <p>Попробуй <a href={`${BASE}search/`}>поиск по блогу</a>.</p>
      <p><a href={BASE}>На главную</a> или <a href={`${BASE}blog/`}>ко всем статьям</a>.</p>
    </div>
  </article>
</Layout>

<script is:inline>
  // Показать, какого адреса нет: читатель видит опечатку сразу
  (function () {
    var el = document.getElementById('missing-path');
    if (el && location.pathname && location.pathname !== '/') el.textContent = location.pathname;
  })();
</script>
