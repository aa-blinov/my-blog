---
import { getCollection } from 'astro:content';
import ChronologyList from '../../components/ChronologyList.astro';
import Layout from '../../layouts/Layout.astro';
import { BASE, sectionPagePath, sectionTitle } from '../../config';
import { formatDate, sortByDateDesc } from '../../utils/date';
import { getSeries, isAbout } from '../../utils/series';

const entries = sortByDateDesc(await getCollection('blog', (entry) => !entry.data.draft && !isAbout(entry.id)));
const bySection = Map.groupBy(entries.filter((entry) => entry.id.includes('/')), (entry) => entry.id.split('/')[0]);
const sections = [...bySection].sort(([a], [b]) => a.localeCompare(b));
const scienceTopics = [...new Set(entries
  .filter((entry) => entry.id.startsWith('science/') && entry.id.split('/').length > 2)
  .map((entry) => sectionPagePath(entry.id.split('/').slice(0, 2).join('/'))))]
  .map((path) => ({ path, title: sectionTitle(path.split('/').at(-1) ?? path) }))
  .sort((a, b) => a.title.localeCompare(b.title, 'ru'));
const seriesFolders = [...new Set(entries.filter((entry) => entry.data.part !== undefined)
  .map((entry) => entry.id.slice(0, entry.id.lastIndexOf('/'))))];
const series = (await Promise.all(seriesFolders.map((folder) => getSeries(folder))))
  .filter((item) => item !== null);
const seriesUnder = (parent: string) => series.filter((item) => {
  const mapped = sectionPagePath(item.folder);
  const seriesParent = mapped !== item.folder ? mapped : item.folder.slice(0, item.folder.lastIndexOf('/'));
  return seriesParent === parent;
});
const hasChildren = (name: string) => seriesUnder(name).length > 0 || (name === 'science' && scienceTopics.length > 0);
const simpleSections = sections.filter(([name]) => !hasChildren(name));
const groupedSections = sections.filter(([name]) => hasChildren(name));

const monthName = new Intl.DateTimeFormat('ru-RU', { month: 'long', timeZone: 'UTC' });
const byYear = Map.groupBy(entries, (entry) => entry.data.date.getUTCFullYear());
const years = [...byYear].map(([year, posts]) => {
  const byMonth = Map.groupBy(posts, (entry) => formatDate(entry.data.date).slice(0, 7));
  const months = [...byMonth].map(([key, posts]) => {
    const name = monthName.format(posts[0].data.date);
    return { id: `month-${key}`, name: name[0].toUpperCase() + name.slice(1), posts };
  });
  return { year, months };
});
---

<Layout title="Архив статей">
  <article>
    <div class="entry-header">
      <h1>Архив статей</h1>
    </div>

    {sections.length > 0 && <section aria-labelledby="archive-topics-heading">
      <h2 class="section-heading" id="archive-topics-heading">Темы</h2>
      <ul class="section-tags blog-index-tags archive-simple-topics" aria-label="Разделы блога" role="list">
        {simpleSections.map(([name, posts]) => (
          <li id={`section-${name}`}><a href={`${BASE}blog/${name}/`}>{sectionTitle(name)} <span class="tag-count">{posts.length}</span></a></li>
        ))}
      </ul>
      <ul class="section-tags archive-topic-tree" aria-label="Разделы с подразделами и циклами" role="list">
        {groupedSections.map(([name, posts]) => (
          <li id={`section-${name}`}>
            <a href={`${BASE}blog/${name}/`}>{sectionTitle(name)} <span class="tag-count">{posts.length}</span></a>
            <ul class:list={['section-tags', 'archive-topic-children', { 'archive-topic-children--topics': name === 'science' }]} role="list">
              {seriesUnder(name).map((item) => (
                <li class="archive-series"><a href={`${BASE}blog/${item.folder}/`}>Цикл «{item.title}»</a></li>
              ))}
              {name === 'science' && scienceTopics.map(({ path, title }) => (
                <li>
                  <a href={`${BASE}blog/${path}/`}>{title}</a>
                  {seriesUnder(path).length > 0 && <ul class="section-tags archive-topic-children" role="list">
                    {seriesUnder(path).map((item) => (
                      <li class="archive-series"><a href={`${BASE}blog/${item.folder}/`}>Цикл «{item.title}»</a></li>
                    ))}
                  </ul>}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>}

    {years.length > 1 && (
      <ul class="archive-jumps" aria-label="Годы" role="list">
        {years.map(({ year }) => <li><a href={`#year-${year}`}>{year}</a></li>)}
      </ul>
    )}

    {years.length === 0 && <p>Пока ничего нет.</p>}

    {years.map(({ year, months }) => (
      <section class="archive-year">
        <h2 class="section-heading" id={`year-${year}`}>{year}</h2>
        {months.length > 1 && (
          <ul class="archive-jumps" aria-label={`Месяцы за ${year} год`} role="list">
            {months.map(({ id, name }) => <li><a href={`#${id}`}>{name}</a></li>)}
          </ul>
        )}
        {months.map(({ id, name, posts }) => (
          <section class="archive-month">
            <h3 id={id}>{name}</h3>
            <ChronologyList posts={posts} showCategory />
          </section>
        ))}
      </section>
    ))}
  </article>
</Layout>

<style>
  .blog-index-tags li,
  .archive-month h3 {
    scroll-margin-top: var(--app-scroll-offset);
  }

  .section-tags a:not(:hover) {
    color: inherit;
  }

  .section-tags a {
    min-height: var(--app-touch-target);
  }

  .archive-simple-topics {
    margin-bottom: var(--app-spacing);
  }

  .archive-topic-tree,
  .archive-topic-children {
    display: block;
    margin: 0;
  }

  .archive-topic-tree {
    margin-bottom: var(--app-spacing-xl);
  }

  .archive-topic-tree > li + li {
    margin-top: var(--app-spacing-sm);
  }

  .archive-topic-children {
    margin-left: var(--app-spacing-lg);
  }

  .archive-topic-children--topics {
    display: flex;
    align-items: flex-start;
    column-gap: var(--app-spacing-md);
  }

  .archive-topic-children--topics > li {
    min-width: 0;
    max-width: 100%;
  }

  .archive-topic-tree .archive-series > a {
    padding: 0;
    border: 0;
    text-decoration: underline;
    text-decoration-color: var(--pico-muted-border-color);
    text-underline-offset: 0.2em;
  }

  .archive-year > h2 {
    margin-bottom: var(--app-spacing-md);
  }

  .archive-jumps {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--app-spacing);
    margin: 0 0 var(--app-spacing);
    padding: 0;
  }

  .archive-jumps li {
    list-style: none;
    margin: 0;
  }

  .archive-jumps a {
    display: inline-flex;
    align-items: center;
    color: var(--pico-muted-color);
    font-size: var(--app-font-control);
    text-underline-offset: 0.2em;
  }

  .archive-jumps a:hover {
    color: var(--pico-primary);
  }

  .archive-year + .archive-year {
    margin-top: var(--app-spacing-2xl);
  }

  .archive-month + .archive-month {
    margin-top: var(--app-spacing-xl);
  }

  .archive-month h3 {
    margin: 0 0 var(--app-spacing-sm);
    font-size: var(--app-font-md);
  }

  @media (max-width: 991px), (pointer: coarse) {
    .archive-jumps a {
      min-height: var(--app-touch-target);
    }
  }
</style>
