---
import { getCollection } from 'astro:content';
import ChronologyList from '../../components/ChronologyList.astro';
import Layout from '../../layouts/Layout.astro';
import { BASE, sectionTitle } from '../../config';
import { formatDate, sortByDateDesc } from '../../utils/date';
import { isAbout } from '../../utils/series';

const entries = sortByDateDesc(await getCollection('blog', (entry) => !entry.data.draft && !isAbout(entry.id)));
const bySection = Map.groupBy(entries.filter((entry) => entry.id.includes('/')), (entry) => entry.id.split('/')[0]);
const sections = [...bySection].sort(([a], [b]) => a.localeCompare(b));

const monthName = new Intl.DateTimeFormat('ru-RU', { month: 'long', timeZone: 'UTC' });
const byYear = Map.groupBy(entries, (entry) => entry.data.date.getUTCFullYear());
const years = [...byYear].map(([year, posts]) => {
  const byMonth = Map.groupBy(posts, (entry) => formatDate(entry.data.date).slice(0, 7));
  const months = [...byMonth].map(([key, posts]) => {
    const name = monthName.format(posts[0].data.date);
    return { id: `month-${key}`, name: name[0].toUpperCase() + name.slice(1), posts };
  });
  return { year, months };
});
---

<Layout title="Архив статей">
  <article>
    <div class="entry-header">
      <h1>Архив статей</h1>
    </div>

    {sections.length > 0 && <section aria-labelledby="archive-topics-heading">
      <h2 class="section-heading" id="archive-topics-heading">Темы</h2>
      <ul class="section-tags blog-index-tags" aria-label="Разделы блога" role="list">
        {sections.map(([name, posts]) => (
          <li id={`section-${name}`}><a href={`${BASE}blog/${name}/`}>{sectionTitle(name)} <span class="tag-count">{posts.length}</span></a></li>
        ))}
      </ul>
    </section>}

    {years.length > 1 && (
      <ul class="archive-jumps" aria-label="Годы" role="list">
        {years.map(({ year }) => <li><a href={`#year-${year}`}>{year}</a></li>)}
      </ul>
    )}

    {years.length === 0 && <p>Пока ничего нет.</p>}

    {years.map(({ year, months }) => (
      <section class="archive-year">
        <h2 class="section-heading" id={`year-${year}`}>{year}</h2>
        {months.length > 1 && (
          <ul class="archive-jumps" aria-label={`Месяцы за ${year} год`} role="list">
            {months.map(({ id, name }) => <li><a href={`#${id}`}>{name}</a></li>)}
          </ul>
        )}
        {months.map(({ id, name, posts }) => (
          <section class="archive-month">
            <h3 id={id}>{name}</h3>
            <ChronologyList posts={posts} showCategory />
          </section>
        ))}
      </section>
    ))}
  </article>
</Layout>

<style>
  .blog-index-tags li,
  .archive-month h3 {
    scroll-margin-top: var(--app-scroll-offset);
  }

  .blog-index-tags a:not(:hover) {
    color: inherit;
  }

  .archive-year > h2 {
    margin-bottom: var(--app-spacing-md);
  }

  .archive-jumps {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--app-spacing);
    margin: 0 0 var(--app-spacing);
    padding: 0;
  }

  .archive-jumps li {
    list-style: none;
    margin: 0;
  }

  .archive-jumps a {
    display: inline-flex;
    align-items: center;
    color: var(--pico-muted-color);
    font-size: var(--app-font-control);
    text-underline-offset: 0.2em;
  }

  .archive-jumps a:hover {
    color: var(--pico-primary);
  }

  .archive-year + .archive-year {
    margin-top: var(--app-spacing-2xl);
  }

  .archive-month + .archive-month {
    margin-top: var(--app-spacing-xl);
  }

  .archive-month h3 {
    margin: 0 0 var(--app-spacing-sm);
    font-size: var(--app-font-md);
  }

  @media (max-width: 991px), (pointer: coarse) {
    .archive-jumps a {
      min-height: var(--app-touch-target);
    }
  }
</style>
