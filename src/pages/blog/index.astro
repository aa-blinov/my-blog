---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';
import { sortByDateDesc } from '../../utils/date';
import { sectionTitle } from '../../config';
import { liveFolders, inLiveFolder, isAbout } from '../../utils/series';

const allEntries = await getCollection('blog');
const published = allEntries.filter((p) => !p.data.draft);
const live = liveFolders(published);
const entries = published.filter((p) => inLiveFolder(p.id, live) && !isAbout(p.id));

// 1. Grouping by top-level sections
interface Group {
  name: string;
  entries: any[];
  maxDate: number;
}

const groups: Record<string, any[]> = {};
const directEntries: any[] = [];

entries.forEach(entry => {
  const parts = entry.id.split('/');
  if (parts.length === 1) {
    directEntries.push(entry);
  } else {
    const sub = parts[0];
    if (!groups[sub]) groups[sub] = [];
    groups[sub].push(entry);
  }
});

const subGroups: Group[] = Object.entries(groups)
  .map(([name, entries]) => ({ 
    name, 
    entries: sortByDateDesc(entries),
    maxDate: Math.max(...entries.map(e => e.data.date.getTime()))
  }))
  .sort((a, b) => a.name.localeCompare(b.name)); // Alphabetical at top level

---

<Layout title="Блог">
  <article>
    <div class="entry-header">
      <h1>Блог</h1>
      <p>По разделам, внутри по дате.</p>
    </div>

    {directEntries.length > 0 && (
      <section class="section-block">
        <header>
          <h2 class="section-heading"><span class="glyph" aria-hidden="true">▸</span>
            /
          </h2>
        </header>
        <PostList posts={directEntries} />
      </section>
    )}

    {subGroups.map((group, index) => (
      <section class="section-block">
        {(index > 0 || directEntries.length > 0) && <hr class="section-divider" />}
        <header>
          <h2 class="section-heading"><span class="glyph" aria-hidden="true">▸</span>
            {sectionTitle(group.name)} <span class="section-slug">{group.name}/</span>
          </h2>
        </header>
        <PostList posts={group.entries} />
      </section>
    ))}
  </article>
</Layout>
