---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { formatDate } from '../../utils/date';
import { sortByDateDesc } from '../../utils/date';

type BlogEntry = CollectionEntry<'blog'>;
type Props = { kind: 'file'; entry: BlogEntry; path?: never } | { kind: 'folder'; path: string; entry?: never };

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  
  // 1. Routes for individual files
  const filePaths = entries.map((entry) => ({
    params: { path: entry.id },
    props: { kind: 'file', entry },
  }));

  // 2. Routes for folders (directories)
  const directoryPaths = new Set<string>();
  entries.forEach((entry) => {
    const parts = entry.id.split('/');
    // Add all parent paths
    for (let i = 1; i < parts.length; i++) {
      directoryPaths.add(parts.slice(0, i).join('/'));
    }
  });

  const folderPaths = Array.from(directoryPaths).map((path) => ({
    params: { path },
    props: { kind: 'folder', path },
  }));

  return [...filePaths, ...folderPaths];
}

const props = Astro.props as Props;
const kind = props.kind;
const entry = props.kind === 'file' ? props.entry : undefined;
const path = props.kind === 'folder' ? props.path : '';

// If it's a file, pre-render the content
let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;
if (entry) {
  const rendered = await render(entry);
  Content = rendered.Content;
}

// If it's a folder, find all entries and group them
interface Group {
  name: string;
  entries: BlogEntry[];
  maxDate: number;
}
let directEntries: BlogEntry[] = [];
let subGroups: Group[] = [];

if (kind === 'folder') {
  const allEntries = await getCollection('blog');
  const entriesInFolder = allEntries.filter((e) => !e.data.draft && e.id.startsWith(path + '/'));
  
  const groups: Record<string, BlogEntry[]> = {};
  
  entriesInFolder.forEach(entry => {
    const relativeSlug = entry.id.slice(path.length + 1);
    const parts = relativeSlug.split('/');
    if (parts.length === 1) {
      directEntries.push(entry);
    } else {
      const sub = parts[0];
      if (!groups[sub]) groups[sub] = [];
      groups[sub].push(entry);
    }
  });

  directEntries = sortByDateDesc(directEntries);
  subGroups = Object.entries(groups)
    .map(([name, entries]) => ({ 
      name, 
      entries: sortByDateDesc(entries),
      maxDate: Math.max(...entries.map(e => e.data.date.getTime()))
    }))
    .sort((a, b) => a.name.localeCompare(b.name)); // Sort sections alphabetically
}

const title = entry ? entry.data.title : (path.split('/').pop() || path);
---

{entry && Content ? (
  <Layout title={entry.data.title} description={entry.data.summary}>
    <article>
      <div class="entry-header">
        <p class="meta">{formatDate(entry.data.date)} · {entry.id}.md</p>
        <hgroup>
          <h1>{entry.data.title}</h1>
          {entry.data.summary && <p class="summary">{entry.data.summary}</p>}
        </hgroup>
      </div>
      <div class="content">
        <Content />
      </div>
    </article>
  </Layout>
) : (
  <Layout title={title}>
    <article>
      <div class="entry-header">
        <hgroup>
          <h1>{title}</h1>
          <p>Раздел: {path}</p>
        </hgroup>
      </div>
      
      {directEntries.length > 0 && (
        <section class="section-block">
          <header>
            <h2 class="section-heading">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19.5 21a3 3 0 0 0 3-3v-4.5a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3V18a3 3 0 0 0 3 3h15ZM1.5 10.146V6a3 3 0 0 1 3-3h5.379a2.25 2.25 0 0 1 1.59.659l2.122 2.121c.14.141.331.22.53.22H19.5a3 3 0 0 1 3 3v1.146A4.483 4.483 0 0 0 19.5 9h-15a4.483 4.483 0 0 0-3 1.146Z" />
              </svg>
              /
            </h2>
          </header>
          <PostList posts={directEntries} />
        </section>
      )}
      {subGroups.map((group, index) => (
        <section class="section-block">
          {(index > 0 || directEntries.length > 0) && <hr class="section-divider" />}
          <header>
            <h2 class="section-heading">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19.5 21a3 3 0 0 0 3-3v-4.5a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3V18a3 3 0 0 0 3 3h15ZM1.5 10.146V6a3 3 0 0 1 3-3h5.379a2.25 2.25 0 0 1 1.59.659l2.122 2.121c.14.141.331.22.53.22H19.5a3 3 0 0 1 3 3v1.146A4.483 4.483 0 0 0 19.5 9h-15a4.483 4.483 0 0 0-3 1.146Z" />
              </svg>
              {group.name}
            </h2>
          </header>
          <PostList posts={group.entries} />
        </section>
      ))}
    </article>
  </Layout>
)}
