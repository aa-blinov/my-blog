---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SeriesNav from '../../components/SeriesNav.astro';
import ArticleFooter from '../../components/ArticleFooter.astro';
import Toc from '../../components/Toc.astro';
import MindMap from '../../components/MindMap.astro';
import { maps } from '../../data/maps';
import Picker from '../../components/Picker.astro';
import Tools from '../../components/Tools.astro';
import { pickers } from '../../data/pickers';
import Questionnaire from '../../components/Questionnaire.astro';
import { questionnaires } from '../../data/questionnaires';
import type { MarkdownHeading } from 'astro';
import { formatDate, humanDate, readingMinutes, plural } from '../../utils/date';
import { sortByDateDesc } from '../../utils/date';
import { getSeries, getAllSeries, seriesOf, isAbout, liveFolders, type Series } from '../../utils/series';
import { BASE, sectionTitle } from '../../config';
import { getArticleSections } from '../../utils/breadcrumb';
import { articleSummary } from '../../utils/article-summary';

// Без своего summary статья уходила в поиск и в превью мессенджеров с общей фразой сайта.
// Первые строки текста говорят о статье больше; 160 знаков помещаются в сниппет поисковика целиком
const DESCRIPTION_LIMIT = 160;

type BlogEntry = CollectionEntry<'blog'>;
type Props = { kind: 'file'; entry: BlogEntry; path?: never } | { kind: 'folder'; path: string; entry?: never };

export async function getStaticPaths() {
  const entries = await getCollection('blog');

  // Раздел без единой статьи не собирается вовсе: ни страница раздела, ни его вводный текст.
  // Иначе пустые страницы попадают в sitemap и в поисковую выдачу.
  const live = liveFolders(entries);
  const folderOf = (id: string) => id.split('/').slice(0, -1).join('/');

  // 1. Routes for individual files
  const filePaths = entries
    .filter((entry) => !isAbout(entry.id) || live.has(folderOf(entry.id)))
    .map((entry) => ({
      params: { path: entry.id },
      props: { kind: 'file', entry },
    }));

  // 2. Routes for folders (directories)
  const directoryPaths = new Set<string>(live);
  // Эта страница собирает статьи о теле, сохраняя их исходные адреса и адрес серии.
  directoryPaths.add('science/body');

  const folderPaths = Array.from(directoryPaths).map((path) => ({
    params: { path },
    props: { kind: 'folder', path },
  }));

  return [...filePaths, ...folderPaths];
}

const props = Astro.props as Props;
const kind = props.kind;
const entry = props.kind === 'file' ? props.entry : undefined;
const path = props.kind === 'folder' ? props.path : '';

// If it's a file, pre-render the content and find its series (folder with part numbers)
let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;
let series = null as Awaited<ReturnType<typeof getSeries>>;
let headings: MarkdownHeading[] = [];
let minutes = 0;
if (entry) {
  const rendered = await render(entry);
  Content = rendered.Content;
  headings = rendered.headings;
  minutes = readingMinutes(entry.body ?? '');
  const folder = seriesOf(entry);
  if (folder) series = await getSeries(folder);
}

// If it's a folder, find all entries and group them
interface Group {
  name: string;
  title: string;
  entries: BlogEntry[];
  maxDate: number;
  isBodyHubLink?: boolean;
  series?: Series | null; // сама группа серия: части по номеру
  nestedSeries: Series[]; // серии глубже группы: одна карточка вместо россыпи частей среди статей
}
const allSeries = await getAllSeries();
const seriesTitles = Object.fromEntries(allSeries.map((s) => [s.folder, s.title]));
let directEntries: BlogEntry[] = [];
let subGroups: Group[] = [];
let folderSeries = null as Awaited<ReturnType<typeof getSeries>>;
let folderAbout: BlogEntry | null = null;
let AboutContent: Awaited<ReturnType<typeof render>>['Content'] | null = null;
let BodySeriesContent: Awaited<ReturnType<typeof render>>['Content'] | null = null;
let bodyArticles: BlogEntry[] = [];
let bodySeriesParts: BlogEntry[] = [];
let bodyMaterialsCount = 0;
const isBodyHub = kind === 'folder' && path === 'science/body';

if (kind === 'folder') {
  const allEntries = await getCollection('blog');
  const entriesInFolder = allEntries.filter((e) => !e.data.draft && e.id.startsWith(path + '/'));

  const groups: Record<string, BlogEntry[]> = {};

  entriesInFolder.forEach(entry => {
    const relativeSlug = entry.id.slice(path.length + 1);
    const parts = relativeSlug.split('/');
    if (parts.length === 1) {
      directEntries.push(entry);
    } else {
      const sub = parts[0];
      if (!groups[sub]) groups[sub] = [];
      groups[sub].push(entry);
    }
  });

  directEntries = sortByDateDesc(directEntries.filter((e) => !isAbout(e.id)));
  folderSeries = await getSeries(path);
  folderAbout = allEntries.find((e) => e.id === `${path}/about-${path.split('/').pop()}` && !e.data.draft) ?? null;
  // about-файл это вводный текст раздела, не строка в списке; в серии части идут по номеру
  if (folderAbout) AboutContent = (await render(folderAbout)).Content;
  if (folderSeries) directEntries = folderSeries.parts;

  if (isBodyHub) {
    bodyArticles = sortByDateDesc(allEntries.filter((e) =>
      !e.data.draft &&
      e.id.startsWith('science/human-body/') &&
      !e.id.slice('science/human-body/'.length).includes('/') &&
      !isAbout(e.id)
    ));
    const bodyEnvironment = await getSeries('science/body-and-environment');
    bodySeriesParts = bodyEnvironment?.parts ?? [];
    const bodyEnvironmentAbout = allEntries.find((e) =>
      e.id === 'science/body-and-environment/about-body-and-environment' && !e.data.draft
    );
    if (bodyEnvironmentAbout) BodySeriesContent = (await render(bodyEnvironmentAbout)).Content;
    bodyMaterialsCount = bodyArticles.length + bodySeriesParts.length;
  }

  if (path === 'science') {
    const bodyArticlesAndParts = allEntries.filter((e) =>
      !e.data.draft &&
      !isAbout(e.id) &&
      (e.id.startsWith('science/human-body/') || e.id.startsWith('science/body-and-environment/'))
    );
    bodyMaterialsCount = bodyArticlesAndParts.length;
    if (bodyArticlesAndParts.length > 0) groups.body = bodyArticlesAndParts;
    delete groups['human-body'];
    delete groups['body-and-environment'];
  }

  subGroups = Object.entries(groups)
    .map(([name, entries]) => {
      const folder = `${path}/${name}`;
      const series = allSeries.find((s) => s.folder === folder) ?? null;
      const nestedSeries = allSeries.filter((s) => s.folder.startsWith(folder + '/'));
      const visible = entries.filter((e) => !isAbout(e.id) && !nestedSeries.some((s) => e.id.startsWith(s.folder + '/')));
      return {
        name,
        title: series?.title ?? sectionTitle(name),
        entries: series ? series.parts : sortByDateDesc(visible),
        maxDate: Math.max(...entries.map(e => e.data.date.getTime())),
        isBodyHubLink: path === 'science' && name === 'body',
        series,
        nestedSeries,
      };
    })
    .sort((a, b) => a.name.localeCompare(b.name)); // Sort sections alphabetically
}

// Папка с about-<имя>.md получает русское имя из него
const folderName = path.split('/').pop() || path;
const title = entry ? entry.data.title : (folderAbout?.data.title.replace(/:\s*Об этой секции$/, '') ?? sectionTitle(folderName));
const bodyHubDescription = 'Научпоп о том, как устроено тело человека и как на него влияют условия вокруг: вес, холод, свет, высота и шум. Здесь собраны отдельные статьи и серия «Тело и среда».';
const articleSections = entry ? getArticleSections(entry.id, seriesTitles) : [];
// У раздела без вводного файла описывать нечем, кроме его же статей: три свежих заголовка
// честнее общей фразы сайта, которая одинакова для любой страницы
const newestTitles = sortByDateDesc([...directEntries, ...subGroups.flatMap((group) => group.entries)])
  .slice(0, 3)
  .map((e) => `«${e.data.title}»`)
  .join(', ');
const folderDescription = isBodyHub
  ? bodyHubDescription
  : folderAbout
    ? articleSummary(folderAbout, DESCRIPTION_LIMIT)
    : newestTitles ? `Раздел «${title}» в блоге Александра Блинова. Свежие статьи: ${newestTitles}.` : undefined;
---

{entry && Content ? (
  <Layout title={entry.data.title} description={articleSummary(entry, DESCRIPTION_LIMIT)} ogImage={`${BASE}og/${entry.id}.png`} viewArticle={`${BASE}blog/${entry.id}/`}>
    <article>
      <div class="entry-header">
        {articleSections.length > 0 && (
          <nav class="article-sections" aria-label="Разделы статьи">
            <ol role="list">
              {articleSections.map(({ title, href }, index) => (
                <li><a href={href}>{title}</a>{index < articleSections.length - 1 && <span aria-hidden="true">/</span>}</li>
              ))}
            </ol>
          </nav>
        )}
        <hgroup>
          <h1>{entry.data.title}</h1>
          {entry.data.summary && <p class="summary">{entry.data.summary}</p>}
        </hgroup>
        {series && <SeriesNav series={series} entry={entry} where="head" />}
        <p class="read-line">
          <time datetime={formatDate(entry.data.date)}>{humanDate(entry.data.date)}</time>
          <span><span class="meta-sep meta-sep-accent" aria-hidden="true">*</span>{' '}≈ {minutes} {plural(minutes, 'минута', 'минуты', 'минут')}</span>
          {headings.filter((h) => h.depth === 2).length >= 3 && (
            <span><span class="meta-sep meta-sep-accent" aria-hidden="true">*</span>{' '}{headings.filter((h) => h.depth === 2).length} {plural(headings.filter((h) => h.depth === 2).length, 'раздел', 'раздела', 'разделов')}</span>
          )}
          <span data-article-views hidden>
            <span class="meta-sep meta-sep-accent" aria-hidden="true">*</span>{' '}
            <span data-view-label></span>
          </span>
        </p>
      </div>
      {headings.filter((h) => h.depth === 2).length >= 6 && <Toc headings={headings} />}
      <div class="content">
        <Content />
        {entry.data.map && maps[entry.data.map] && <MindMap data={maps[entry.data.map]} />}
        {entry.data.picker && pickers[entry.data.picker] && <Picker data={pickers[entry.data.picker]} />}
        {entry.data.tools === 'antidepressants' && <Tools />}
        {entry.data.questionnaire && questionnaires[entry.data.questionnaire] && <Questionnaire data={questionnaires[entry.data.questionnaire]} />}
      </div>
      {series && <SeriesNav series={series} entry={entry} where="foot" />}
      <ArticleFooter entry={entry} inSeries={!!series} />
    </article>
  </Layout>
) : (
  <Layout title={title} description={folderDescription}>
    <article>
      <div class="entry-header">
        <p class="meta"><span>{folderSeries ? 'серия' : 'раздел'}</span></p>
        <hgroup>
          <h1>{title}</h1>
        </hgroup>
      </div>

      {AboutContent && (
        <div class="content">
          <AboutContent />
        </div>
      )}
      {isBodyHub && <div class="content"><p>{bodyHubDescription}</p></div>}

      {isBodyHub ? (
        <>
          <section class="section-block">
            <h2 class="section-heading">Тело человека</h2>
            <PostList posts={bodyArticles} level={3} />
          </section>
          <section class="section-block">
            <hr class="section-divider" />
            <h2 class="section-heading">Тело и среда</h2>
            {BodySeriesContent && <div class="content"><BodySeriesContent /></div>}
            <PostList posts={bodySeriesParts} numbered level={3} />
          </section>
        </>
      ) : (
        <>
          {directEntries.length > 0 && (
            <section class="section-block">
              <PostList posts={directEntries} numbered={!!folderSeries} level={2} />
            </section>
          )}
          {subGroups.map((group, index) => (
            <section class="section-block">
              {(index > 0 || directEntries.length > 0) && <hr class="section-divider" />}
              <header>
                <h2 class="section-heading">
                  {group.title}
                </h2>
              </header>
              {group.nestedSeries.length > 0 && (
                <div class="post-list">
                  {group.nestedSeries.map((s) => (
                    <div class="post-list-item">
                      <p class="meta"><span>серия</span><span class="meta-sep" aria-hidden="true">~</span><span>{s.parts.length} {plural(s.parts.length, 'часть', 'части', 'частей')}</span></p>
                      <h3 class="post-title"><a class="post-title-link" href={`${BASE}blog/${s.folder}/`}>{s.title}</a></h3>
                      {s.about?.data.summary && <p class="summary">{s.about.data.summary}</p>}
                    </div>
                  ))}
                </div>
              )}
              {group.isBodyHubLink ? (
                <div class="post-list">
                  <div class="post-list-item">
                    <h3 class="post-title"><a class="post-title-link" href={`${BASE}blog/science/body/`}>Все материалы о теле</a></h3>
                    <p class="summary">{bodyMaterialsCount} {plural(bodyMaterialsCount, 'материал', 'материала', 'материалов')}, включая серию «Тело и среда».</p>
                  </div>
                </div>
              ) : (group.entries.length > 0 || group.nestedSeries.length === 0) && <PostList posts={group.entries} numbered={!!group.series} />}
            </section>
          ))}
        </>
      )}
    </article>
  </Layout>
)}

<style>
  /* Разделы это навигация над заголовком: зазор до H1 больше, чем у H1 до подзаголовка,
     иначе крошки читались как часть заголовка */
  .article-sections {
    margin-bottom: var(--app-spacing);
    color: var(--pico-muted-color);
    font-size: var(--app-font-sm);
  }

  /* Черта держится за раздел слева: при переносе строка кончается на «/», а новая
     начинается с названия, ровно под заголовком */
  .article-sections ol {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--app-spacing-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-sections li {
    display: inline-flex;
    gap: var(--app-spacing-md);
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Pico ставит в пункт nav невидимый символ, и flex-отступ сдвигал первый раздел с края заголовка */
  .article-sections li::before {
    content: none;
  }

  .article-sections a {
    color: inherit;
    margin: 0;
    padding: 0;
    text-underline-offset: 0.2em;
  }

  .article-sections a:hover {
    color: var(--pico-primary);
  }

  @media (max-width: 640px), (pointer: coarse) {
    .article-sections a {
      display: inline-flex;
      align-items: center;
      min-height: var(--app-touch-target);
    }
  }
</style>
