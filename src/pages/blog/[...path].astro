---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SeriesNav from '../../components/SeriesNav.astro';
import ArticleFooter from '../../components/ArticleFooter.astro';
import Toc from '../../components/Toc.astro';
import MindMap from '../../components/MindMap.astro';
import { maps } from '../../data/maps';
import Picker from '../../components/Picker.astro';
import Tools from '../../components/Tools.astro';
import { pickers } from '../../data/pickers';
import Questionnaire from '../../components/Questionnaire.astro';
import { questionnaires } from '../../data/questionnaires';
import type { MarkdownHeading } from 'astro';
import { formatDate, readingMinutes, plural } from '../../utils/date';
import { sortByDateDesc } from '../../utils/date';
import { getSeries, seriesOf, isAbout } from '../../utils/series';
import { sectionTitle } from '../../config';
import { getArticleSections } from '../../utils/breadcrumb';

type BlogEntry = CollectionEntry<'blog'>;
type Props = { kind: 'file'; entry: BlogEntry; path?: never } | { kind: 'folder'; path: string; entry?: never };

export async function getStaticPaths() {
  const entries = await getCollection('blog');

  // 1. Routes for individual files
  const filePaths = entries.map((entry) => ({
    params: { path: entry.id },
    props: { kind: 'file', entry },
  }));

  // 2. Routes for folders (directories)
  const directoryPaths = new Set<string>();
  entries.forEach((entry) => {
    const parts = entry.id.split('/');
    // Add all parent paths
    for (let i = 1; i < parts.length; i++) {
      directoryPaths.add(parts.slice(0, i).join('/'));
    }
  });

  const folderPaths = Array.from(directoryPaths).map((path) => ({
    params: { path },
    props: { kind: 'folder', path },
  }));

  return [...filePaths, ...folderPaths];
}

const props = Astro.props as Props;
const kind = props.kind;
const entry = props.kind === 'file' ? props.entry : undefined;
const path = props.kind === 'folder' ? props.path : '';

// If it's a file, pre-render the content and find its series (folder with part numbers)
let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;
let series = null as Awaited<ReturnType<typeof getSeries>>;
let headings: MarkdownHeading[] = [];
let minutes = 0;
if (entry) {
  const rendered = await render(entry);
  Content = rendered.Content;
  headings = rendered.headings;
  minutes = readingMinutes(entry.body ?? '');
  const folder = seriesOf(entry);
  if (folder) series = await getSeries(folder);
}

// If it's a folder, find all entries and group them
interface Group {
  name: string;
  entries: BlogEntry[];
  maxDate: number;
}
let directEntries: BlogEntry[] = [];
let subGroups: Group[] = [];
let folderSeries = null as Awaited<ReturnType<typeof getSeries>>;
let folderAbout: BlogEntry | null = null;
let AboutContent: Awaited<ReturnType<typeof render>>['Content'] | null = null;

if (kind === 'folder') {
  const allEntries = await getCollection('blog');
  const entriesInFolder = allEntries.filter((e) => !e.data.draft && e.id.startsWith(path + '/'));

  const groups: Record<string, BlogEntry[]> = {};

  entriesInFolder.forEach(entry => {
    const relativeSlug = entry.id.slice(path.length + 1);
    const parts = relativeSlug.split('/');
    if (parts.length === 1) {
      directEntries.push(entry);
    } else {
      const sub = parts[0];
      if (!groups[sub]) groups[sub] = [];
      groups[sub].push(entry);
    }
  });

  directEntries = sortByDateDesc(directEntries.filter((e) => !isAbout(e.id)));
  folderSeries = await getSeries(path);
  folderAbout = allEntries.find((e) => e.id === `${path}/about-${path.split('/').pop()}` && !e.data.draft) ?? null;
  // about-файл это вводный текст раздела, не строка в списке; в серии части идут по номеру
  if (folderAbout) AboutContent = (await render(folderAbout)).Content;
  if (folderSeries) directEntries = folderSeries.parts;
  subGroups = Object.entries(groups)
    .map(([name, entries]) => ({
      name,
      entries: sortByDateDesc(entries),
      maxDate: Math.max(...entries.map(e => e.data.date.getTime()))
    }))
    .sort((a, b) => a.name.localeCompare(b.name)); // Sort sections alphabetically
}

// Папка с about-<имя>.md получает русское имя из него
const folderName = path.split('/').pop() || path;
const title = entry ? entry.data.title : (folderAbout?.data.title.replace(/:\s*Об этой секции$/, '') ?? sectionTitle(folderName));
const articleSections = entry ? getArticleSections(entry.id) : [];
---

{entry && Content ? (
  <Layout title={entry.data.title} description={entry.data.summary}>
    <article>
      <div class="entry-header">
        {articleSections.length > 0 && (
          <nav class="article-sections" aria-label="Разделы статьи">
            <ol role="list">
              {articleSections.map(({ title, href }, index) => (
                <li>{index > 0 && <span aria-hidden="true">/</span>}<a href={href}>{title}</a></li>
              ))}
            </ol>
          </nav>
        )}
        <hgroup>
          <h1>{entry.data.title}</h1>
          {entry.data.summary && <p class="summary">{entry.data.summary}</p>}
        </hgroup>
        {series && <SeriesNav series={series} entry={entry} where="head" />}
        <p class="read-line">
          <time datetime={formatDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
          <span class="meta-sep" aria-hidden="true">~</span>
          <span>≈ {minutes} {plural(minutes, 'минута', 'минуты', 'минут')}</span>
          {headings.filter((h) => h.depth === 2).length >= 3 && (
            <>
              <span class="meta-sep" aria-hidden="true">~</span>
              <span>{headings.filter((h) => h.depth === 2).length} {plural(headings.filter((h) => h.depth === 2).length, 'раздел', 'раздела', 'разделов')}</span>
            </>
          )}
        </p>
      </div>
      {headings.filter((h) => h.depth === 2).length >= 6 && <Toc headings={headings} />}
      <div class="content">
        <Content />
        {entry.data.map && maps[entry.data.map] && <MindMap data={maps[entry.data.map]} />}
        {entry.data.picker && pickers[entry.data.picker] && <Picker data={pickers[entry.data.picker]} />}
        {entry.data.tools === 'antidepressants' && <Tools />}
        {entry.data.questionnaire && questionnaires[entry.data.questionnaire] && <Questionnaire data={questionnaires[entry.data.questionnaire]} />}
      </div>
      {series && <SeriesNav series={series} entry={entry} where="foot" />}
      <ArticleFooter entry={entry} inSeries={!!series} />
    </article>
  </Layout>
) : (
  <Layout title={title}>
    <article>
      <div class="entry-header">
        <p class="meta"><span>{folderSeries ? 'серия' : 'раздел'}</span><span class="meta-sep" aria-hidden="true">~</span><span>{path}/</span></p>
        <hgroup>
          <h1>{title}</h1>
        </hgroup>
      </div>

      {AboutContent && (
        <div class="content">
          <AboutContent />
        </div>
      )}

      {directEntries.length > 0 && (
        <section class="section-block">
          <PostList posts={directEntries} numbered={!!folderSeries} level={2} />
        </section>
      )}
      {subGroups.map((group, index) => (
        <section class="section-block">
          {(index > 0 || directEntries.length > 0) && <hr class="section-divider" />}
          <header>
            <h2 class="section-heading">
              {sectionTitle(group.name)} <span class="section-slug">{group.name}/</span>
            </h2>
          </header>
          <PostList posts={group.entries} />
        </section>
      ))}
    </article>
  </Layout>
)}

<script>
  // Список после статьи остаётся доступен без JavaScript; скрипт поднимает одну ссылку к месту, где заканчивается введение.
  const content = document.querySelector('article > .content');
  const recommendation = document.getElementById('article-recommendation');
  if (content && recommendation) {
    const blocks = [...content.children];
    const firstHeading = blocks.find((block) => block.tagName === 'H2');
    const firstParagraph = blocks.find((block) => block.tagName === 'P');
    if (firstHeading) firstHeading.before(recommendation);
    else if (firstParagraph) firstParagraph.after(recommendation);
    if (firstHeading || firstParagraph) recommendation.hidden = false;
  }
</script>

<style>
  .article-sections {
    margin-bottom: var(--app-spacing-md);
    color: var(--pico-muted-color);
    font-size: var(--app-font-sm);
  }

  .article-sections ol,
  .article-sections li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--app-spacing-md);
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-sections a {
    color: inherit;
    margin: 0;
    padding: 0;
    text-underline-offset: 0.2em;
  }

  .article-sections a:hover {
    color: var(--pico-primary);
  }

  @media (max-width: 640px), (pointer: coarse) {
    .article-sections a {
      display: inline-flex;
      align-items: center;
      min-height: var(--app-touch-target);
    }
  }
</style>
