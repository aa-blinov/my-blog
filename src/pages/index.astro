---
import PageFromEntry from '../components/PageFromEntry.astro';
import PostList from '../components/PostList.astro';
import NoteList from '../components/NoteList.astro';
import { getCollection, render } from 'astro:content';
import { sortByDateDesc } from '../utils/date';
import { BASE, RECENT_POSTS_LIMIT, sectionTitle } from '../config';
import { isAbout, liveFolders, getSeries } from '../utils/series';

const pages = (await getCollection('pages')).filter((e) => !e.data.draft);
const homeEntry = pages.find((e) => e.id === 'main');

const posts = sortByDateDesc(
  (await getCollection('blog')).filter((p) => !p.data.draft && !isAbout(p.id))
).slice(0, RECENT_POSTS_LIMIT);

// Карта блога: серии первыми, затем верхние разделы с числом статей (about-* не считаем)
const published = (await getCollection('blog')).filter((p) => !p.data.draft);
const articles = published.filter((p) => !isAbout(p.id));
const live = liveFolders(published);
const plural = (n: number, one: string, few: string, many: string) =>
  n % 10 === 1 && n % 100 !== 11 ? one : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? few : many;
const seriesFolders = [...new Set(articles.filter((p) => p.data.part !== undefined).map((p) => p.id.slice(0, p.id.lastIndexOf('/'))))];
const seriesRows = (await Promise.all(seriesFolders.map((f) => getSeries(f)))).filter((s) => s !== null);
const topSections = [...new Set(articles.map((p) => p.id.split('/')[0]))]
  .filter((s) => live.has(s))
  .map((s) => ({ slug: s, title: sectionTitle(s), count: articles.filter((p) => p.id.startsWith(s + '/')).length }))
  .sort((a, b) => b.count - a.count);

const recentNotes = sortByDateDesc(
  (await getCollection('notes')).filter((n) => !n.data.draft)
).slice(0, 3);

let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;
let entryData: { data: { title: string; date: Date; summary?: string }; fileLabel: string } | null = null;

if (homeEntry) {
  const rendered = await render(homeEntry);
  Content = rendered.Content;
  entryData = {
    data: homeEntry.data,
    fileLabel: 'main.md',
  };
}
---

<PageFromEntry entry={entryData} fallbackTitle="Главная" fallbackH1="Главная" prompt="main &gt;">
  {Content ? <Content /> : <p>Добавь в <code>content/pages/</code> файл <code>main.md</code> с frontmatter: <code>title</code>, <code>date</code>.</p>}

  <div class="site-map">
    {seriesRows.map((s) => (
      <div class="post-list-item">
        <p class="meta"><span>{s.folder}/</span><span class="meta-sep" aria-hidden="true">~</span><span>{s.parts.length} {plural(s.parts.length, 'часть', 'части', 'частей')}</span></p>
        <h3><a href={`${BASE}blog/${s.folder}/`} class="post-title-link">Серия «{s.title}»</a></h3>
      </div>
    ))}
    {topSections.map((s) => (
      <div class="post-list-item">
        <p class="meta"><span>{s.slug}/</span><span class="meta-sep" aria-hidden="true">~</span><span>{s.count} {plural(s.count, 'статья', 'статьи', 'статей')}</span></p>
        <h3><a href={`${BASE}blog/${s.slug}/`} class="post-title-link">{s.title}</a></h3>
      </div>
    ))}
  </div>
  
  <div class="recent-posts">
    <h2 class="section-heading">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M11.25 4.533A9.707 9.707 0 0 0 6 3a9.735 9.735 0 0 0-3.25.555.75.75 0 0 0-.5.707v14.25a.75.75 0 0 0 1 .707A8.237 8.237 0 0 1 6 18.75c1.995 0 3.823.707 5.25 1.886V4.533ZM12.75 20.636A8.214 8.214 0 0 1 18 18.75c1.057 0 2.056.2 2.964.562a.75.75 0 0 0 1-.707V4.356a.75.75 0 0 0-.5-.707A9.735 9.735 0 0 0 18 3a9.707 9.707 0 0 0-5.25 1.533v16.103Z" />
      </svg>
      Свежие статьи
    </h2>
    <PostList posts={posts} />
    
    <div class="all-articles">
      <h3>
        <a href={`${BASE}blog/`} class="post-title-link all-articles-link">
          Смотреть все статьи &rarr;
        </a>
      </h3>
    </div>
  </div>

  {recentNotes.length > 0 && (
    <div class="recent-posts">
      <h2 class="section-heading">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M4.5 3.75A1.5 1.5 0 0 0 3 5.25v13.5a1.5 1.5 0 0 0 1.5 1.5h15a1.5 1.5 0 0 0 1.5-1.5V5.25a1.5 1.5 0 0 0-1.5-1.5h-15Zm2.25 4.5a.75.75 0 0 1 .75-.75h9a.75.75 0 0 1 0 1.5h-9a.75.75 0 0 1-.75-.75Zm0 3.75a.75.75 0 0 1 .75-.75h9a.75.75 0 0 1 0 1.5h-9a.75.75 0 0 1-.75-.75Zm.75 3a.75.75 0 0 0 0 1.5h5.25a.75.75 0 0 0 0-1.5H7.5Z" clip-rule="evenodd" />
        </svg>
        Заметки
      </h2>
      <NoteList notes={recentNotes} />
      <div class="all-articles">
        <h3>
          <a href={`${BASE}notes/`} class="post-title-link all-articles-link">
            Все заметки &rarr;
          </a>
        </h3>
      </div>
    </div>
  )}
</PageFromEntry>
