---
import PageFromEntry from '../components/PageFromEntry.astro';
import ChronologyList from '../components/ChronologyList.astro';
import NoteList from '../components/NoteList.astro';
import Arrow from '../components/Arrow.astro';
import { getCollection, render } from 'astro:content';
import { sortByDateDesc } from '../utils/date';
import { BASE, RECENT_POSTS_LIMIT, sectionTitle } from '../config';
import { isAbout, liveFolders, getSeries } from '../utils/series';

const pages = (await getCollection('pages')).filter((e) => !e.data.draft);
const homeEntry = pages.find((e) => e.id === 'main');

// Вводные страницы разделов не входят в список статей и счётчики.
const published = (await getCollection('blog')).filter((p) => !p.data.draft);
const articles = published.filter((p) => !isAbout(p.id));
const posts = sortByDateDesc(articles).slice(0, RECENT_POSTS_LIMIT);
const live = liveFolders(published);
const seriesFolders = [...new Set(articles.filter((p) => p.data.part !== undefined).map((p) => p.id.slice(0, p.id.lastIndexOf('/'))))];
const seriesRows = (await Promise.all(seriesFolders.map((f) => getSeries(f)))).filter((s) => s !== null);
const topSections = [...new Set(articles.map((p) => p.id.split('/')[0]))]
  .filter((s) => live.has(s))
  .map((s) => ({ slug: s, title: sectionTitle(s), count: articles.filter((p) => p.id.startsWith(s + '/')).length }))
  .sort((a, b) => b.count - a.count);

const recentNotes = sortByDateDesc(
  (await getCollection('notes')).filter((n) => !n.data.draft)
).slice(0, 3);

const startingPoints = [
  {
    topic: 'ИИ',
    title: 'Как не потерять себя',
    description: 'Как работа с ИИ влияет на собственное мышление.',
    slug: 'ai/how-not-to-lose-yourself',
  },
  {
    topic: 'Научпоп',
    title: 'Прокрастинация как ремонт настроения',
    description: 'Как неприятные чувства заставляют нас откладывать дела.',
    slug: 'science/mind/procrastination-is-not-about-time',
  },
  {
    topic: 'Личное',
    title: 'Право передумать',
    description: 'Что делать, когда давняя цель больше не твоя.',
    slug: 'life/the-right-to-change-your-mind',
  },
  {
    topic: 'Разработка',
    title: 'Цикл, из которого сделан агент',
    description: 'Как работает цикл кодового агента.',
    slug: 'dev/agent/loop',
  },
];

let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;
let entryData: { data: { title: string; date: Date; summary?: string }; fileLabel: string } | null = null;

if (homeEntry) {
  const rendered = await render(homeEntry);
  Content = rendered.Content;
  entryData = {
    data: homeEntry.data,
    fileLabel: 'main.md',
  };
}
---

<PageFromEntry entry={entryData} fallbackTitle="Главная" fallbackH1="Главная" prompt="main &gt;" hideMeta>
  {Content ? <Content /> : <p>Добавь в <code>content/pages/</code> файл <code>main.md</code> с frontmatter: <code>title</code>, <code>date</code>.</p>}

  <section class="home-topics" aria-labelledby="home-topics-heading">
    <h2 id="home-topics-heading" class="section-heading">Темы</h2>
    <ul class="section-tags" role="list">
      {topSections.map((s) => (
        <li><a href={`${BASE}blog/${s.slug}/`}>{s.title} <span class="tag-count">{s.count}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="start-here" aria-labelledby="start-here-heading">
    <h2 id="start-here-heading" class="section-heading">Начать отсюда</h2>
    <ul class="start-here-list" role="list">
      {startingPoints.map((item) => (
        <li>
          <a class="start-here-link post-title-link" href={`${BASE}blog/${item.slug}/`}>
            <span class="start-here-topic">{item.topic}</span>
            <span class="start-here-title">{item.title}</span>
            <span class="start-here-description">{item.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="recent-posts recent-first">
    <div class="recent-header">
      <h2 class="section-heading">Свежие статьи</h2>
      <a href={`${BASE}blog/`} class="post-title-link all-articles-link">Все статьи <Arrow /></a>
    </div>
      <ChronologyList posts={posts} showDetails />
  </section>

  {seriesRows.length > 0 && <div class="site-map">
    <h2 class="section-heading">Серии статей</h2>
    <ul class="section-tags">
      {seriesRows.map((s) => (
        <li><a href={`${BASE}blog/${s.folder}/`}>{s.title} <span class="tag-count">{s.parts.length}</span></a></li>
      ))}
    </ul>
  </div>}

  {recentNotes.length > 0 && (
    <div class="recent-posts">
      <h2 class="section-heading">Заметки</h2>
      <NoteList notes={recentNotes} />
      <div class="all-articles">
        <p class="all-articles-line"><a href={`${BASE}notes/`} class="post-title-link all-articles-link">Все заметки <Arrow /></a></p>
      </div>
    </div>
  )}
</PageFromEntry>

<style>
  .home-topics {
    margin-top: var(--app-spacing-xl);
  }

  .home-topics .section-heading {
    margin-bottom: var(--app-spacing-md);
  }

  .home-topics .section-tags a {
    min-height: var(--app-touch-target);
  }

  .recent-header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: space-between;
    column-gap: var(--app-spacing);
    margin-bottom: var(--app-spacing-md);
  }

  .recent-header .section-heading {
    margin: 0;
  }

  .recent-header .all-articles-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--app-touch-target);
    font-size: var(--app-font-sm);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .start-here {
    margin-top: var(--app-spacing-2xl);
  }

  .start-here .section-heading {
    margin-bottom: var(--app-spacing-md);
  }

  .start-here-list {
    margin: 0;
    padding: 0;
  }

  .start-here-list li {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--pico-muted-border-color);
    list-style: none;
  }

  .start-here-list li:last-child {
    border-bottom: 1px solid var(--pico-muted-border-color);
  }

  .start-here-link {
    display: grid;
    grid-template-columns: minmax(7.5rem, max-content) minmax(0, 1fr);
    align-items: baseline;
    column-gap: var(--app-spacing);
    row-gap: var(--app-spacing-xs);
    min-height: var(--app-touch-target);
    padding-block: var(--app-spacing-md);
  }

  .start-here-topic {
    grid-column: 1;
    grid-row: 1 / span 2;
    color: var(--pico-muted-color);
    font-family: var(--font-family);
    font-size: var(--app-font-control);
  }

  .start-here-title {
    grid-column: 2;
    text-decoration: underline;
    text-decoration-color: var(--pico-muted-border-color);
    text-underline-offset: 0.2em;
  }

  .start-here-description {
    grid-column: 2;
    color: var(--pico-muted-color);
    font-size: var(--app-font-sm);
    line-height: 1.45;
  }

  .start-here-link:is(:hover, :focus-visible) .start-here-title {
    color: var(--pico-primary);
    text-decoration-color: currentColor;
  }

  @media (max-width: 480px) {
    .start-here-link {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--app-spacing-xs);
    }

    .start-here-topic,
    .start-here-title,
    .start-here-description {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
